chemas import HealthResponse","-from aip.api.security import Principal, get_principal","-from aip.core.config import get_settings","-from aip.core.llm import get_router as get_llm_router","-from aip.core.providers import provider_setup_report","-","-router = APIRouter(tags=[\"system\"])","-","-","-@router.get(\"/health\", response_model=HealthResponse)","-async def health() -> HealthResponse:","-    from aip import __version__","-    from aip.rag.corpus import corpus_summary","-","-    settings = get_settings()","-    configured = settings.configured_providers()","-    llm = get_llm_router()","-    return HealthResponse(","-        status=\"ok\",","-        version=__version__,","-        environment=settings.environment,","-        providers_configured=configured,","-        # 'ollama' alone means local inference only, which works but is slower","-        # and weaker than the hosted free tiers.","-        degraded_mode=configured in ([], [\"ollama\"]),","-        corpus=corpus_summary(),","-        total_model_cost_usd=llm.ledger.total_cost_usd,","-    )","-","-","-@router.get(\"/providers\")","-async def providers() -> dict[str, Any]:","-    \"\"\"Which free model providers are configured, and how to enable the rest.","-","-    Powers the onboarding screen. Every provider listed has a genuine free tier;","-    the platform runs with none of them configured, better with one, and best","-    with several, because the critic ensemble draws its independence from having","-    several different model families available.","-    \"\"\"","-    settings = get_settings()","-    report = provider_setup_report(settings)","-    configured = [row for row in report if row[\"configured\"]]","-    return {","-        \"configured_count\": len(configured),","-        \"total_count\": len(report),","-        \"ensemble_diversity\": min(1.0, len(configured) / 4),","-        \"recommendation\": _recommendation(len(configured)),","-        \"providers\": report,","-    }","-","-","-def _recommendation(count: int) -> str:","-    if count == 0:","-        return (","-            \"No provider is configured. Every analytical capability - geometry, \"","-            \"daylight, ventilation, code compliance, Vastu reasoning and cost - \"","-            \"works fully without one. Add a free key to enable generated \"","-            \"commentary and the judgement-based critics.\"","-        )","-    if count == 1:","-        return (","-            \"One provider configured. The pipeline works, but the critic \"","-            \"ensemble is drawing every judgement from a single model family, so \"","-            \"its members make correlated mistakes. Add a second free provider to \"","-            \"get genuinely independent opinions.\"","-        )","-    if count < 4:","-        return (","-            f\"{count} providers configured. Ensemble diversity is reasonable. \"","-            f\"Adding more raises resilience to any one free tier being exhausted.\"","-        )","-    return (","-        f\"{count} providers configured. Full ensemble diversity and strong \"","-        f\"failover; the platform will stay available even if several free tiers \"","-        f\"are rate-limited at once.\"","-    )","-","-","-@router.get(\"/capabilities\")","-async def capabilities(principal: Principal = Depends(get_principal)) -> dict[str, Any]:","-    \"\"\"Machine-readable description of what this deployment can do.\"\"\"","-    from aip.agents.critics import committee_charter","-    from aip.engines.vastu.knowledge import corpus_statistics","-","-    settings = get_settings()","-    has_generative = bool(settings.configured_providers())","-    return {","-        \"phases\": {","-            \"architecture\": {","-                \"available\": True,","-                \"features\": [","-                    \"floorplan generation\", \"elevations\", \"sections\", \"roof layout\",","-                    \"column grid\", \"stair design\", \"daylight optimisation\",","-                    \"ventilation optimisation\", \"privacy analysis\",","-                    \"accessibility checking\", \"circulation analysis\",","-                ],","-            },","-            \"interior\": {","-                \"available\": True,","-                \"features\": [","-                    \"furniture placement\", \"furniture schedule\", \"palette generation\",","-                    \"material selection\", \"lighting design\", \"room redesign brief\",","-                ],","-                \"note\": (","-                    \"Photorealistic renders require an image provider; layout, \"","-                    \"specification and costing are computed locally.\"","-                ),","-            },","-            \"vastu\": {","-                \"available\": True,","-                \"features\": [","-                    \"explainable rule evaluation\", \"traditional/modern reconciliation\",","-                    \"counterfactual remedies\", \"conflict resolution\", \"provenance citations\",","-                ],","-                \"corpus\": corpus_statistics(),","-            },","-            \"cost\": {","-                \"available\": True,","-                \"features\": [","-                    \"quantity takeoff\", \"bill of quantities\", \"Monte Carlo risk simulation\",","-                    \"cash flow forecast\", \"delay probability\", \"firm-specific calibration\",","-                ],","-            },","-            \"experience\": {","-                \"available\": True,","-                \"features\": [","-                    \"3D model (GLB)\", \"OBJ export\", \"WebXR VR walkthrough\",","-                    \"AR placement\", \"voice narration script\", \"budget simulation\",","-                ],","-            },","-        },","-        \"committee\": committee_charter(),","-        \"generative_critics_active\": has_generative,","-        \"zero_cost\": True,","-        \"scope\": principal.scope,","-    }","+\"\"\"Health, capability discovery and onboarding status.\"\"\"\r","+\r","+from __future__ import annotations\r","+\r","+from typing import Any\r","+\r","+from fastapi import APIRouter, Depends\r","+\r","+from aip.api.schemas import HealthResponse\r","+from aip.api.security import Principal, get_principal\r","+from aip.core.config import get_settings\r","+from aip.core.llm import get_router as get_llm_router\r","+from aip.core.providers import provider_setup_report\r","+\r","+router = APIRouter(tags=[\"system\"])\r","+\r","+\r","+@router.get(\"/health\", response_model=HealthResponse)\r","+async def health() -> HealthResponse:\r","+    from aip import __version__\r","+    from aip.rag.corpus import corpus_summary\r","+\r","+    settings = get_settings()\r","+    configured = settings.configured_providers()\r","+    llm = get_llm_router()\r","+    return HealthResponse(\r","+        status=\"ok\",\r","+        version=__version__,\r","+        environment=settings.environment,\r","+        providers_configured=configured,\r","+        # 'ollama' alone means local inference only, which works but is slower\r","+        # and weaker than the hosted free tiers.\r","+        degraded_mode=configured in ([], [\"ollama\"]),\r","+        corpus=corpus_summary(),\r","+        total_model_cost_usd=llm.ledger.total_cost_usd,\r","+    )\r","+\r","+\r","+@router.get(\"/providers\")\r","+async def providers() -> dict[str, Any]:\r","+    \"\"\"Which free model providers are configured, and how to enable the rest.\r","+\r","+    Powers the onboarding screen. Every provider listed has a genuine free tier;\r","+    the platform runs with none of them configured, better with one, and best\r","+    with several, because the critic ensemble draws its independence from having\r","+    several different model families available.\r","+    \"\"\"\r","+    settings = get_settings()\r","+    report = provider_setup_report(settings)\r","+    configured = [row for row in report if row[\"configured\"]]\r","+    return {\r","+        \"configured_count\": len(configured),\r","+        \"total_count\": len(report),\r","+        \"ensemble_diversity\": min(1.0, len(configured) / 4),\r","+        \"recommendation\": _recommendation(len(configured)),\r","+        \"providers\": report,\r","+    }\r","+\r","+\r","+def _recommendation(count: int) -> str:\r","+    if count == 0:\r","+        return (\r","+            \"No provider is configured. Every analytical capability - geometry, \"\r","+            \"daylight, ventilation, code compliance, Vastu reasoning and cost - \"\r","+            \"works fully without one. Add a free key to enable generated \"\r","+            \"commentary and the judgement-based critics.\"\r","+        )\r","+    if count == 1:\r","+        return (\r","+            \"One provider configured. The pipeline works, but the critic \"\r","+            \"ensemble is drawing every judgement from a single model family, so \"\r","+            \"its members make correlated mistakes. Add a second free provider to \"\r","+            \"get genuinely independent opinions.\"\r","+        )\r","+    if count < 4:\r","+        return (\r","+            f\"{count} providers configured. Ensemble diversity is reasonable. \"\r","+            f\"Adding more raises resilience to any one free tier being exhausted.\"\r","+        )\r","+    return (\r","+        f\"{count} providers configured. Full ensemble diversity and strong \"\r","+        f\"failover; the platform will stay available even if several free tiers \"\r","+        f\"are rate-limited at once.\"\r","+    )\r","+\r","+\r","+@router.get(\"/capabilities\")\r","+async def capabilities(principal: Principal = Depends(get_principal)) -> dict[str, Any]:\r","+    \"\"\"Machine-readable description of what this deployment can do.\"\"\"\r","+    from aip.agents.critics import committee_charter\r","+    from aip.engines.vastu.knowledge import corpus_statistics\r","+\r","+    settings = get_settings()\r","+    has_generative = bool(settings.configured_providers())\r","+    return {\r","+        \"phases\": {\r","+            \"architecture\": {\r","+                \"available\": True,\r","+                \"features\": [\r","+                    \"floorplan generation\", \"elevations\", \"sections\", \"roof layout\",\r","+                    \"column grid\", \"stair design\", \"daylight optimisation\",\r","+                    \"ventilation optimisation\", \"privacy analysis\",\r","+                    \"accessibility checking\", \"circulation analysis\",\r","+                ],\r","+            },\r","+            \"interior\": {\r","+                \"available\": True,\r","+                \"features\": [\r","+                    \"furniture placement\", \"furniture schedule\", \"palette generation\",\r","+                    \"material selection\", \"lighting design\", \"room redesign brief\",\r","+                ],\r","+                \"note\": (\r","+                    \"Photorealistic renders require an image provider; layout, \"\r","+                    \"specification and costing are computed locally.\"\r","+                ),\r","+            },\r","+            \"vastu\": {\r","+                \"available\": True,\r","+                \"features\": [\r","+                    \"explainable rule evaluation\", \"traditional/modern reconciliation\",\r","+                    \"counterfactual remedies\", \"conflict resolution\", \"provenance citations\",\r","+                ],\r","+                \"corpus\": corpus_statistics(),\r","+            },\r","+            \"cost\": {\r","+                \"available\": True,\r","+                \"features\": [\r","+                    \"quantity takeoff\", \"bill of quantities\", \"Monte Carlo risk simulation\",\r","+                    \"cash flow forecast\", \"delay probability\", \"firm-specific calibration\",\r","+                ],\r","+            },\r","+            \"experience\": {\r","+                \"available\": True,\r","+                \"features\": [\r","+                    \"3D model (GLB)\", \"OBJ export\", \"WebXR VR walkthrough\",\r","+                    \"AR placement\", \"voice narration script\", \"budget simulation\",\r","+                ],\r","+            },\r","+        },\r","+        \"committee\": committee_charter(),\r","+        \"generative_critics_active\": has_generative,\r","+        \"zero_cost\": True,\r","+        \"scope\": principal.scope,\r","+    }\r","+\r","+\r","+@router.get(\"/vastu/calibration\")\r","+async def vastu_calibration_status() -> dict[str, Any]:\r","+    \"\"\"Inspect the Vastu weight calibration subsystem status and rule cards.\"\"\"\r","+    from aip.engines.vastu.calibration import cards_from_corpus\r","+    cards = cards_from_corpus()\r","+    return {\r","+        \"status\": \"active\",\r","+        \"calibrated_rules_count\": len(cards),\r","+        \"trainable_parameter\": \"rule_weight_w_r\",\r","+        \"frozen_invariants\": [\"modern_validity\", \"provenance\", \"stance_t\"],\r","+        \"cards\": [\r","+            {\r","+                \"rule_id\": c.rule_id,\r","+                \"provenance\": c.provenance,\r","+                \"modern_validity\": c.modern_validity,\r","+                \"prior_weight\": c.prior_weight,\r","+            }\r","+            for c in cards\r","+        ],\r","+    }\r"]}]},{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\vastu\\calibration\\CALIBRATION.md","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":147,"lines":["+# Vastu weight calibration\r","+\r","+## What is actually trainable\r","+\r","+The Vastu engine is a defeasible rule system, and it should stay one. A learned\r","+model that outputs a compliance score cannot cite Mayamata 9.12, and the whole\r","+claim in README.md — that every number traces to a critic, a model and a\r","+citation — dies the moment the score comes out of a network.\r","+\r","+Of everything in the engine, exactly one object is fit from data:\r","+\r","+| Quantity | Source | Trainable |\r","+|---|---|---|\r","+| rule satisfaction | geometry, computed | no — it is arithmetic |\r","+| `modern_validity` | editorial, from the corpus | **no, deliberately** |\r","+| provenance, rationale, remedy | the treatises | no |\r","+| stance `t` | the client's slider | no |\r","+| **rule weight `w_r`** | currently hand-set | **yes** |\r","+\r","+`modern_validity` is frozen by the fit and asserted frozen by a test. If the\r","+optimiser were allowed to move it, the stance slider would stop meaning what the\r","+report says it means, and the traditional/modern reconciliation would become\r","+unciteable.\r","+\r","+## The finding, before the protocol\r","+\r","+Measured on synthetic panels with the engine's own arithmetic:\r","+\r","+* Averaging 29 rules compresses plans into a narrow band. On a representative\r","+  set the **median score gap between two plans is about 0.05** on a 0–1 scale.\r","+* **Uniform weights already reproduce a correctly-weighted ranking on ~80% of\r","+  plan pairs.** The entire ceiling for weight calibration is the remaining 20%.\r","+* Simulated practitioners comparing plans that close together agree with each\r","+  other **~55% of the time**. They cannot reliably resolve the pairs where the\r","+  weights would matter.\r","+\r","+Both numbers reproduce with `python -m calibration.power`.\r","+\r","+Taken together: calibrating `w` is a real but small effect, bounded above by a\r","+fifth of the ordering and bounded below by what a panel can actually see. It is\r","+worth building the pipeline — you need it to *know* that, and you need it again\r","+whenever the corpus grows — but it should not be the next quarter's work.\r","+\r","+Higher-return uses of the same practitioner hours, in order:\r","+\r","+1. **Close the 94 of 578 undetermined knowledge-graph placements** named in\r","+   README.md. Coverage beats weighting: an undetermined placement contributes\r","+   nothing, whereas a mis-weighted rule still contributes most of its signal.\r","+2. **Validate satisfaction functions, not weights.** Ask practitioners whether\r","+   the engine is reading a plan correctly on a given rule, not which of two\r","+   plans is better overall. That is a question they answer reliably, and a wrong\r","+   satisfaction function is a much larger error than a wrong weight.\r","+3. **Report Vastu as a profile, not a scalar.** The compression above is the\r","+   reason Vastu moved only −1.8% across arms in the ablation table: a 29-rule\r","+   mean has little dynamic range, so the axis carries little weight in the\r","+   Borda count regardless of `w`. A per-quarter or per-severity breakdown\r","+   discriminates where the mean cannot.\r","+\r","+## If you run the panel anyway\r","+\r","+**Instrument.** Pairwise, never absolute. \"Which of these two is more\r","+Vastu-compliant\" is stable; a 0–100 rating carries a large drifting per-rater\r","+offset. `fit_absolute` exists and fits per-rater affine calibration, but it is\r","+the weaker instrument.\r","+\r","+**Stance.** Ask every rater at `t = 1.0`, strict classical. The modern head does\r","+not need human labels at all — it is supervised by the analytical critics you\r","+already run, since \"kitchen in SE\" has a modern validity that is a solar-gain\r","+and cross-ventilation calculation. Never mix stances in one fit.\r","+\r","+**Plan set.** Curate for contrast, do not sample representatively. In the sweep,\r","+a contrasted set with 1000 comparisons recovered weights better (ρ≈0.78) than a\r","+representative set with 2000 (ρ≈0.55). You are measuring rule weights, not\r","+estimating a population. `select_panel_plans` picks the spanning subset.\r","+\r","+**Comparison set.** `select_pairs` runs greedy D-optimality over the\r","+Bradley-Terry design vectors and drops near-ties. Pair design helps meaningfully\r","+once plans are contrasted, and barely at all before that — plan diversity\r","+dominates. Check `coverage()` before sending anything out: a rule with\r","+negligible leverage will not be identified no matter how many raters you hire.\r","+Fix it by adding plans that vary on that rule, not by buying more judgements.\r","+\r","+**Budget.** About 2000 designed comparisons for ρ≈0.8 recovery. Five raters at\r","+400 each, roughly two hours a head at 15–20 seconds per comparison. Overlap at\r","+least 10% of comparisons across raters — `panel_agreement` needs them, and that\r","+agreement figure is your ceiling, not your baseline.\r","+\r","+## The ship gate\r","+\r","+A fitted weight vector may replace the hand-set corpus only if all five hold:\r","+\r","+1. `cross_validate` grouped **by plan** beats the prior on held-out pairs.\r","+   Splitting by pair leaks — the same plan appears on both sides.\r","+2. `check_monotonicity` returns clean.\r","+3. Held-out accuracy is **below** `panel_agreement`. Above it means overfitting,\r","+   not insight; there is no signal up there to have learned.\r","+4. `bootstrap_weights` resamples **plans**, not pairs, and every weight you ship\r","+   as changed has an interval excluding the prior.\r","+5. `adapter.write_back` is used, so unidentified rules keep the editor's value.\r","+\r","+Gate 1 is the one that will fail, and failing it is a legitimate result: report\r","+that the panel did not improve on the corpus and keep the hand-set weights.\r","+\r","+## Structural guarantees\r","+\r","+Two properties hold by construction rather than by trusting the data, and both\r","+are tested:\r","+\r","+* **`w ≥ 0` is bounded, so the score is monotone in every rule.** Improving any\r","+  assessable rule can never lower the score, because\r","+  `∂score_i/∂S_ir = a_ir / Σ_r a_ir ≥ 0`. A negative weight would assert that\r","+  satisfying a classical rule makes a plan less compliant, which no citation\r","+  supports.\r","+* **Unassessable rules leave the denominator**, never enter as zero. Same rule\r","+  the corpus already follows.\r","+\r","+One pathology is handled explicitly: a rule with no variance across the panel\r","+still has a non-zero gradient — it pulls every plan toward its own fixed\r","+satisfaction, compressing the spread, an effect `beta` absorbs almost exactly.\r","+Its weight is confounded with `beta`, so the fit freezes it at the prior and\r","+reports it in `FitResult.frozen`. Leaving it to the bootstrap does not work; that\r","+was found by a test that failed.\r","+\r","+## Wiring it in\r","+\r","+`adapter.py` names what it needs from the reasoner rather than calling it, since\r","+`backend/` was not to hand. The contract is two vectors per plan: per-rule\r","+satisfaction, and per-rule assessability, **separately**. If the reasoner\r","+currently returns one number that collapses \"scored 0\" into \"not assessable\",\r","+that is the first thing to fix — it is the same false-precision failure the\r","+corpus refuses everywhere else.\r","+\r","+```\r","+calibration/\r","+  schema.py    RuleCard, PlanObservation, PairwiseJudgement, CalibrationSet\r","+  model.py     the engine's arithmetic + analytic Jacobian\r","+  fit.py       sign-constrained Bradley-Terry, ridge toward the corpus\r","+  design.py    which plans and which comparisons to buy\r","+  validate.py  grouped CV, monotonicity, bootstrap, panel agreement\r","+  adapter.py   the seam to aip.engines.vastu.reasoner\r","+  power.py     how many comparisons you need\r","+  demo_synthetic.py\r","+  tests/       22 tests\r","+```\r","+\r","+Everything in `power.py` and `demo_synthetic.py` is synthetic. It tells you\r","+about the estimator, not about Vastu.\r"]}],"created":true},{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\vastu\\calibration\\__init__.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":12,"lines":["+\"\"\"Vastu weight calibration subsystem.\r","+\r","+Calibrates rule weights w_r from practitioner pairwise judgments while keeping\r","+modern_validity, treaties provenance, and non-negativity structural guarantees frozen.\r","+\"\"\"\r","+\r","+from .adapter import cards_from_corpus, observation_from_report, build_set, write_back\r","+from .schema import CalibrationSet, PlanObservation, RuleCard, PairwiseJudgement\r","+from .model import score, effective_weights, score_and_jacobian, normalise\r","+from .fit import fit_pairwise, FitResult\r","+from .design import select_pairs, coverage\r","+from .validate import identifiable, bootstrap_weights, cross_validate, check_monotonicity, panel_agreement\r"]}],"created":true},{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\vastu\\calibration\\adapter.py","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":113,"lines":["+\"\"\"The seam between this pipeline and the shipped reasoner.\r","+\r","+Wires the calibration module to `aip.engines.vastu.knowledge.RULES` and\r","+`aip.engines.vastu.engine.VastuReport`.\r","+\r","+The contract is narrow on purpose -- one call per plan, returning per-rule\r","+satisfaction and assessability.\r","+\"\"\"\r","+\r","+from __future__ import annotations\r","+\r","+from typing import Any, Callable, Iterable\r","+\r","+import numpy as np\r","+\r","+from .schema import CalibrationSet, PlanObservation, RuleCard\r","+\r","+\r","+def cards_from_corpus(corpus: Iterable[Any] | None = None) -> tuple[RuleCard, ...]:\r","+    \"\"\"Expected per rule object: .rule_id / .id, .provenance / .school, .modern_validity,\r","+    and .weight if the corpus already carries a hand-set weight.\r","+\r","+    If corpus is omitted, defaults directly to `aip.engines.vastu.knowledge.RULES`.\r","+    Ordering is fixed here and must not change between building the panel set\r","+    and fitting -- the design matrix is positional.\r","+    \"\"\"\r","+    if corpus is None:\r","+        from aip.engines.vastu.knowledge import RULES\r","+        corpus = RULES\r","+\r","+    cards = []\r","+    for rule in corpus:\r","+        rid = getattr(rule, \"rule_id\", None) or getattr(rule, \"id\")\r","+        school = getattr(rule, \"school\", None)\r","+        provenance = getattr(rule, \"provenance\", None) or (school.value if hasattr(school, \"value\") else str(school or \"contemporary\"))\r","+        cards.append(\r","+            RuleCard(\r","+                rule_id=str(rid),\r","+                provenance=str(provenance),\r","+                modern_validity=float(getattr(rule, \"modern_validity\", 1.0)),\r","+                prior_weight=float(getattr(rule, \"weight\", 1.0)),\r","+            )\r","+        )\r","+    return tuple(sorted(cards, key=lambda c: c.rule_id))\r","+\r","+\r","+def observation_from_report(\r","+    plan_id: str, report: Any, cards: tuple[RuleCard, ...],\r","+) -> PlanObservation:\r","+    \"\"\"Expected per finding/verdict in `report`: .rule_id, .compliance / .satisfaction in [0,1],\r","+    and .assessable (or a status of \"not_assessable\").\r","+\r","+    A rule absent from the report is treated as not assessable, never as zero.\r","+    \"\"\"\r","+    by_rule = {}\r","+    items = getattr(report, \"verdicts\", getattr(report, \"findings\", report))\r","+    if isinstance(items, dict):\r","+        items = items.values()\r","+\r","+    for f in items:\r","+        rid = str(getattr(f, \"rule_id\", None) or getattr(f, \"id\", \"\"))\r","+        if not rid:\r","+            continue\r","+        status = str(getattr(f, \"status\", \"\")).lower()\r","+        assessable = bool(getattr(f, \"assessable\", status != \"not_assessable\"))\r","+        satisfaction = float(getattr(f, \"compliance\", getattr(f, \"satisfaction\", 0.0)))\r","+        by_rule[rid] = (satisfaction, assessable)\r","+\r","+    sat = np.zeros(len(cards))\r","+    msk = np.zeros(len(cards), dtype=bool)\r","+    for i, c in enumerate(cards):\r","+        if c.rule_id in by_rule:\r","+            sat[i], msk[i] = by_rule[c.rule_id]\r","+    return PlanObservation(\r","+        plan_id=plan_id,\r","+        rule_ids=tuple(c.rule_id for c in cards),\r","+        satisfaction=sat,\r","+        assessable=msk,\r","+    )\r","+\r","+\r","+def build_set(\r","+    plans: dict[str, Any],\r","+    cards: tuple[RuleCard, ...] | None = None,\r","+    evaluate: Callable[[Any], Any] | None = None,\r","+) -> CalibrationSet:\r","+    \"\"\"`evaluate` is the reasoner call: design -> report.\r","+    Defaults to cards_from_corpus() and VastuEngine().analyse().\r","+    \"\"\"\r","+    if cards is None:\r","+        cards = cards_from_corpus()\r","+    if evaluate is None:\r","+        from aip.engines.vastu.engine import VastuEngine\r","+        _engine = VastuEngine()\r","+        evaluate = lambda p: _engine.analyse(p)\r","+\r","+    cs = CalibrationSet(cards=cards)\r","+    for pid, design in plans.items():\r","+        cs.add_plan(observation_from_report(pid, evaluate(design), cards))\r","+    return cs\r","+\r","+\r","+def write_back(weights: dict[str, float], identifiable: dict[str, bool],\r","+               prior: dict[str, float]) -> dict[str, float]:\r","+    \"\"\"Only weights the bootstrap identified are allowed to change.\r","+\r","+    Everything else keeps the editor's value, so a rule the panel never\r","+    exercised is not quietly re-weighted by noise.\r","+    \"\"\"\r","+    return {\r","+        rid: (weights[rid] if identifiable.get(rid, False) else prior.get(rid, 1.0))\r","+        for rid in weights\r","+    }\r"]}],"created":true}],"moreFiles":15,"changedFiles":["F:\\Users\\shrey\\Desktop\\AI Project\\.claude\\launch.json","F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\api\\routers\\system.py","F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\architecture\\airflow.py","F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\architecture\\cfd.py","F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\architecture\\metrics.py","F:\\Users\\shrey\\Desktop\\AI Project\\backend