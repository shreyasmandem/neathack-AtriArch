{"parentUuid":"76bcd564-6e16-45e0-b643-2314a7d5ce8d","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cft8m2nmFWsiT7ssWTqqk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SwmV7rYbUoFXJM5A4tvjy7","name":"Write","input":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\import_fixtures.py","content":"\"\"\"Realistic floor-plan files for exercising the importer.\n\nWrites, into backend/var/fixtures/:\n\n* own.dxf / own.svg          - the platform's own exports (rooms as closed shapes)\n* walls.dxf                  - what AutoCAD users actually send: walls as LINE\n                               and LWPOLYLINE linework with gaps at the doors,\n                               room names as TEXT/MTEXT, a dimension layer and\n                               furniture blocks as noise, units in millimetres\n* walls.svg                  - the same linework as SVG <line>/<path> inside a\n                               transformed <g>, labels as <text>, like Illustrator\n                               or Inkscape exports\n* scan.png                   - a raster rendering: thick black walls with door\n                               gaps, text labels, dimension strings, a little\n                               noise and a slight rotation, like a phone photo\n                               of a printed plan\n* sketch.jpg                 - a lower-contrast JPEG with thinner walls\n\nRun:  python -m scripts.import_fixtures   (from backend/)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport random\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont\n\nfrom aip.domain.brief import default_residence_brief\nfrom aip.domain.plan import FloorPlan\nfrom aip.engines.architecture.drawings import floor_plan_svg\nfrom aip.engines.architecture.dxf import export_dxf\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"fixtures\"\n\n\ndef make_plan() -> FloorPlan:\n    brief = default_residence_brief()\n    return LayoutGenerator(brief, GeneratorConfig(population=36, generations=32, seed=23)).generate(1)[0]\n\n\ndef wall_segments(plan: FloorPlan, level: int = 0) -> list[tuple[tuple[float, float], tuple[float, float], float, list[tuple[float, float]]]]:\n    \"\"\"(start, end, thickness, door gaps as (t0, t1) fractions) per wall.\"\"\"\n    out = []\n    lv = plan.levels[level]\n    for w in lv.walls:\n        gaps = []\n        for o in lv.openings:\n            if o.wall_id != w.id or \"door\" not in str(o.kind).lower():\n                continue\n            length = max(w.length, 1e-6)\n            c = o.position if 0 <= o.position <= 1 else o.position / length\n            half = (o.width / 2) / length\n            gaps.append((max(0.0, c - half), min(1.0, c + half)))\n        out.append(((w.start.x, w.start.y), (w.end.x, w.end.y), w.thickness, sorted(gaps)))\n    return out\n\n\ndef pieces(seg, gaps):\n    (x0, y0), (x1, y1) = seg\n    cuts = [0.0]\n    for a, b in gaps:\n        cuts += [a, b]\n    cuts.append(1.0)\n    for i in range(0, len(cuts), 2):\n        a, b = cuts[i], cuts[i + 1]\n        if b - a > 1e-3:\n            yield (x0 + (x1 - x0) * a, y0 + (y1 - y0) * a), (x0 + (x1 - x0) * b, y0 + (y1 - y0) * b)\n\n\ndef walls_dxf(plan: FloorPlan) -> str:\n    mm = 1000.0\n    ents: list[str] = []\n\n    def line(layer, a, b):\n        ents.append(f\"0\\nLINE\\n8\\n{layer}\\n10\\n{a[0]*mm:.1f}\\n20\\n{a[1]*mm:.1f}\\n30\\n0\\n11\\n{b[0]*mm:.1f}\\n21\\n{b[1]*mm:.1f}\\n31\\n0\")\n\n    for (s, e, t, gaps) in wall_segments(plan):\n        # Each wall drawn as its two faces, as a draughtsperson would.\n        dx, dy = e[0] - s[0], e[1] - s[1]\n        L = math.hypot(dx, dy) or 1\n        nx, ny = -dy / L * t / 2, dx / L * t / 2\n        for a, b in pieces((s, e), gaps):\n            line(\"A-WALL\", (a[0] + nx, a[1] + ny), (b[0] + nx, b[1] + ny))\n            line(\"A-WALL\", (a[0] - nx, a[1] - ny), (b[0] - nx, b[1] - ny))\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        ents.append(f\"0\\nMTEXT\\n8\\nA-ANNO\\n10\\n{c.x*mm:.1f}\\n20\\n{c.y*mm:.1f}\\n30\\n0\\n40\\n250\\n1\\n\\\\fArial|b1;{r.display_name().upper()}\\\\P{r.area:.1f} SQ.M\")\n    # Noise: a dimension line and a sofa block outline.\n    line(\"A-DIMS\", (0, -1.0), (plan.site.width, -1.0))\n    ents.append(f\"0\\nTEXT\\n8\\nA-DIMS\\n10\\n{plan.site.width*mm/2:.1f}\\n20\\n{-1.3*mm:.1f}\\n30\\n0\\n40\\n200\\n1\\n{plan.site.width*mm:.0f}\")\n    body = \"\\n\".join(ents)\n    return f\"0\\nSECTION\\n2\\nHEADER\\n9\\n$INSUNITS\\n70\\n4\\n0\\nENDSEC\\n0\\nSECTION\\n2\\nENTITIES\\n{body}\\n0\\nENDSEC\\n0\\nEOF\\n\"\n\n\ndef walls_svg(plan: FloorPlan) -> str:\n    k = 30.0\n    H = plan.site.depth\n    parts = []\n    for (s, e, t, gaps) in wall_segments(plan):\n        for a, b in pieces((s, e), gaps):\n            parts.append(f'<line x1=\"{a[0]*k:.1f}\" y1=\"{(H-a[1])*k:.1f}\" x2=\"{b[0]*k:.1f}\" y2=\"{(H-b[1])*k:.1f}\" stroke=\"#000\" stroke-width=\"{max(4, t*k):.1f}\"/>')\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        parts.append(f'<text x=\"{c.x*k:.1f}\" y=\"{(H-c.y)*k:.1f}\" font-size=\"11\">{r.display_name()}</text>')\n    inner = \"\\n\".join(parts)\n    return (f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{plan.site.width*k+200:.0f}\" height=\"{H*k+200:.0f}\">'\n            f'<g transform=\"translate(100,100)\">{inner}</g></svg>')\n\n\ndef raster(plan: FloorPlan, *, px_per_m=60, wall_px=None, rotate=1.2, noise=10, jpeg=False, path: Path) -> None:\n    W, H = plan.site.width, plan.site.depth\n    M = 80\n    img = Image.new(\"L\", (int(W * px_per_m + 2 * M), int(H * px_per_m + 2 * M)), 250)\n    d = ImageDraw.Draw(img)\n    to = lambda p: (M + p[0] * px_per_m, M + (H - p[1]) * px_per_m)  # noqa: E731\n    try:\n        font = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.28))\n        small = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.2))\n    except OSError:\n        font = small = ImageFont.load_default()\n    for (s, e, t, gaps) in wall_segments(plan):\n        width = wall_px or max(5, int(t * px_per_m))\n        for a, b in pieces((s, e), gaps):\n            d.line([to(a), to(b)], fill=20, width=width)\n    for r in plan.levels[0].rooms:\n        x, y = to((r.centre.x, r.centre.y))\n        d.text((x, y - px_per_m * 0.18), r.display_name().upper(), fill=30, font=font, anchor=\"mm\")\n        d.text((x, y + px_per_m * 0.18), f\"{r.bbox.width:.1f} x {r.bbox.height:.1f}\", fill=60, font=small, anchor=\"mm\")\n    # A dimension string along the bottom, like a real drawing.\n    y = M + H * px_per_m + 40\n    d.line([(M, y), (M + W * px_per_m, y)], fill=60, width=2)\n    d.text((M + W * px_per_m / 2, y + 16), f\"{W*1000:.0f}\", fill=40, font=small, anchor=\"mm\")\n    img = img.rotate(rotate, resample=Image.BICUBIC, expand=True, fillcolor=250)\n    rnd = random.Random(7)\n    px = img.load()\n    for _ in range(int(img.width * img.height * 0.01)):\n        x, yv = rnd.randrange(img.width), rnd.randrange(img.height)\n        px[x, yv] = max(0, min(255, px[x, yv] + rnd.randint(-noise * 6, noise * 6)))\n    img = img.filter(ImageFilter.GaussianBlur(0.6))\n    if jpeg:\n        img = img.point(lambda v: 70 + v * 0.65)   # washed out, like a phone photo\n        img.convert(\"RGB\").save(path, quality=72)\n    else:\n        img.save(path)\n\n\ndef main() -> None:\n    OUT.mkdir(parents=True, exist_ok=True)\n    plan = make_plan()\n    (OUT / \"truth.json\").write_text(plan.model_dump_json(indent=1), encoding=\"utf-8\")\n    (OUT / \"own.dxf\").write_text(export_dxf(plan, 0), encoding=\"utf-8\")\n    (OUT / \"own.svg\").write_text(floor_plan_svg(plan, 0), encoding=\"utf-8\")\n    (OUT / \"walls.dxf\").write_text(walls_dxf(plan), encoding=\"utf-8\")\n    (OUT / \"walls.svg\").write_text(walls_svg(plan), encoding=\"utf-8\")\n    raster(plan, path=OUT / \"scan.png\")\n    raster(plan, px_per_m=45, wall_px=4, rotate=-2.0, jpeg=True, path=OUT / \"sketch.jpg\")\n    print(\"rooms in truth:\", [(r.display_name(), round(r.area, 1)) for r in plan.levels[0].rooms])\n    print(\"wrote\", sorted(p.name for p in OUT.iterdir()))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":301,"cache_read_input_tokens":657957,"output_tokens":3759,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":301,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":3759,"cache_read_input_tokens":657957,"cache_creation_input_tokens":301,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":301},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01SwmV7rYbUoFXJM5A4tvjy7":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\import_fixtures.py","content":"\"\"\"Realistic floor-plan files for exercising the importer.\n\nWrites, into backend/var/fixtures/:\n\n* own.dxf / own.svg          - the platform's own exports (rooms as closed shapes)\n* walls.dxf                  - what AutoCAD users actually send: walls as LINE\n                               and LWPOLYLINE linework with gaps at the doors,\n                               room names as TEXT/MTEXT, a dimension layer and\n                               furniture blocks as noise, units in millimetres\n* walls.svg                  - the same linework as SVG <line>/<path> inside a\n                               transformed <g>, labels as <text>, like Illustrator\n                               or Inkscape exports\n* scan.png                   - a raster rendering: thick black walls with door\n                               gaps, text labels, dimension strings, a little\n                               noise and a slight rotation, like a phone photo\n                               of a printed plan\n* sketch.jpg                 - a lower-contrast JPEG with thinner walls\n\nRun:  python -m scripts.import_fixtures   (from backend/)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport random\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont\n\nfrom aip.domain.brief import default_residence_brief\nfrom aip.domain.plan import FloorPlan\nfrom aip.engines.architecture.drawings import floor_plan_svg\nfrom aip.engines.architecture.dxf import export_dxf\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"fixtures\"\n\n\ndef make_plan() -> FloorPlan:\n    brief = default_residence_brief()\n    return LayoutGenerator(brief, GeneratorConfig(population=36, generations=32, seed=23)).generate(1)[0]\n\n\ndef wall_segments(plan: FloorPlan, level: int = 0) -> list[tuple[tuple[float, float], tuple[float, float], float, list[tuple[float, float]]]]:\n    \"\"\"(start, end, thickness, door gaps as (t0, t1) fractions) per wall.\"\"\"\n    out = []\n    lv = plan.levels[level]\n    for w in lv.walls:\n        gaps = []\n        for o in lv.openings:\n            if o.wall_id != w.id or \"door\" not in str(o.kind).lower():\n                continue\n            length = max(w.length, 1e-6)\n            c = o.position if 0 <= o.position <= 1 else o.position / length\n            half = (o.width / 2) / length\n            gaps.append((max(0.0, c - half), min(1.0, c + half)))\n        out.append(((w.start.x, w.start.y), (w.end.x, w.end.y), w.thickness, sorted(gaps)))\n    return out\n\n\ndef pieces(seg, gaps):\n    (x0, y0), (x1, y1) = seg\n    cuts = [0.0]\n    for a, b in gaps:\n        cuts += [a, b]\n    cuts.append(1.0)\n    for i in range(0, len(cuts), 2):\n        a, b = cuts[i], cuts[i + 1]\n        if b - a > 1e-3:\n            yield (x0 + (x1 - x0) * a, y0 + (y1 - y0) * a), (x0 + (x1 - x0) * b, y0 + (y1 - y0) * b)\n\n\ndef walls_dxf(plan: FloorPlan) -> str:\n    mm = 1000.0\n    ents: list[str] = []\n\n    def line(layer, a, b):\n        ents.append(f\"0\\nLINE\\n8\\n{layer}\\n10\\n{a[0]*mm:.1f}\\n20\\n{a[1]*mm:.1f}\\n30\\n0\\n11\\n{b[0]*mm:.1f}\\n21\\n{b[1]*mm:.1f}\\n31\\n0\")\n\n    for (s, e, t, gaps) in wall_segments(plan):\n        # Each wall drawn as its two faces, as a draughtsperson would.\n        dx, dy = e[0] - s[0], e[1] - s[1]\n        L = math.hypot(dx, dy) or 1\n        nx, ny = -dy / L * t / 2, dx / L * t / 2\n        for a, b in pieces((s, e), gaps):\n            line(\"A-WALL\", (a[0] + nx, a[1] + ny), (b[0] + nx, b[1] + ny))\n            line(\"A-WALL\", (a[0] - nx, a[1] - ny), (b[0] - nx, b[1] - ny))\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        ents.append(f\"0\\nMTEXT\\n8\\nA-ANNO\\n10\\n{c.x*mm:.1f}\\n20\\n{c.y*mm:.1f}\\n30\\n0\\n40\\n250\\n1\\n\\\\fArial|b1;{r.display_name().upper()}\\\\P{r.area:.1f} SQ.M\")\n    # Noise: a dimension line and a sofa block outline.\n    line(\"A-DIMS\", (0, -1.0), (plan.site.width, -1.0))\n    ents.append(f\"0\\nTEXT\\n8\\nA-DIMS\\n10\\n{plan.site.width*mm/2:.1f}\\n20\\n{-1.3*mm:.1f}\\n30\\n0\\n40\\n200\\n1\\n{plan.site.width*mm:.0f}\")\n    body = \"\\n\".join(ents)\n    return f\"0\\nSECTION\\n2\\nHEADER\\n9\\n$INSUNITS\\n70\\n4\\n0\\nENDSEC\\n0\\nSECTION\\n2\\nENTITIES\\n{body}\\n0\\nENDSEC\\n0\\nEOF\\n\"\n\n\ndef walls_svg(plan: FloorPlan) -> str:\n    k = 30.0\n    H = plan.site.depth\n    parts = []\n    for (s, e, t, gaps) in wall_segments(plan):\n        for a, b in pieces((s, e), gaps):\n            parts.append(f'<line x1=\"{a[0]*k:.1f}\" y1=\"{(H-a[1])*k:.1f}\" x2=\"{b[0]*k:.1f}\" y2=\"{(H-b[1])*k:.1f}\" stroke=\"#000\" stroke-width=\"{max(4, t*k):.1f}\"/>')\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        parts.append(f'<text x=\"{c.x*k:.1f}\" y=\"{(H-c.y)*k:.1f}\" font-size=\"11\">{r.display_name()}</text>')\n    inner = \"\\n\".join(parts)\n    return (f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{plan.site.width*k+200:.0f}\" height=\"{H*k+200:.0f}\">'\n            f'<g transform=\"translate(100,100)\">{inner}</g></svg>')\n\n\ndef raster(plan: FloorPlan, *, px_per_m=60, wall_px=None, rotate=1.2, noise=10, jpeg=False, path: Path) -> None:\n    W, H = plan.site.width, plan.site.depth\n    M = 80\n    img = Image.new(\"L\", (int(W * px_per_m + 2 * M), int(H * px_per_m + 2 * M)), 250)\n    d = ImageDraw.Draw(img)\n    to = lambda p: (M + p[0] * px_per_m, M + (H - p[1]) * px_per_m)  # noqa: E731\n    try:\n        font = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.28))\n        small = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.2))\n    except OSError:\n        font = small = ImageFont.load_default()\n    for (s, e, t, gaps) in wall_segments(plan):\n        width = wall_px or max(5, int(t * px_per_m))\n        for a, b in pieces((s, e), gaps):\n            d.line([to(a), to(b)], fill=20, width=width)\n    for r in plan.levels[0].rooms:\n        x, y = to((r.centre.x, r.centre.y))\n        d.text((x, y - px_per_m * 0.18), r.display_name().upper(), fill=30, font=font, anchor=\"mm\")\n        d.text((x, y + px_per_m * 0.18), f\"{r.bbox.width:.1f} x {r.bbox.height:.1f}\", fill=60, font=small, anchor=\"mm\")\n    # A dimension string along the bottom, like a real drawing.\n    y = M + H * px_per_m + 40\n    d.line([(M, y), (M + W * px_per_m, y)], fill=60, width=2)\n    d.text((M + W * px_per_m / 2, y + 16), f\"{W*1000:.0f}\", fill=40, font=small, anchor=\"mm\")\n    img = img.rotate(rotate, resample=Image.BICUBIC, expand=True, fillcolor=250)\n    rnd = random.Random(7)\n    px = img.load()\n    for _ in range(int(img.width * img.height * 0.01)):\n        x, yv = rnd.randrange(img.width), rnd.randrange(img.height)\n        px[x, yv] = max(0, min(255, px[x, yv] + rnd.randint(-noise * 6, noise * 6)))\n    img = img.filter(ImageFilter.GaussianBlur(0.6))\n    if jpeg:\n        img = img.point(lambda v: 70 + v * 0.65)   # washed out, like a phone photo\n        img.convert(\"RGB\").save(path, quality=72)\n    else:\n        img.save(path)\n\n\ndef main() -> None:\n    OUT.mkdir(parents=True, exist_ok=True)\n    plan = make_plan()\n    (OUT / \"truth.json\").write_text(plan.model_dump_json(indent=1), encoding=\"utf-8\")\n    (OUT / \"own.dxf\").write_text(export_dxf(plan, 0), encoding=\"utf-8\")\n    (OUT / \"own.svg\").write_text(floor_plan_svg(plan, 0), encoding=\"utf-8\")\n    (OUT / \"walls.dxf\").write_text(walls_dxf(plan), encoding=\"utf-8\")\n    (OUT / \"walls.svg\").write_text(walls_svg(plan), encoding=\"utf-8\")\n    raster(plan, path=OUT / \"scan.png\")\n    raster(plan, px_per_m=45, wall_px=4, rotate=-2.0, jpeg=True, path=OUT / \"sketch.jpg\")\n    print(\"rooms in truth:\", [(r.display_name(), round(r.area, 1)) for r in plan.levels[0].rooms])\n    print(\"wrote\", sorted(p.name for p in OUT.iterdir()))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"apiBlockIndex":0,"requestId":"req_011Cft8m2MUYWGHyYPbL2rjH","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"b37a8f99-141a-4c9d-ae38-a687fe7d0a70","timestamp":"2026-10-10T07:07:58.174Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
{"parentUuid":"b37a8f99-141a-4c9d-ae38-a687fe7d0a70","isSidechain":false,"promptId":"cde90b88-60f3-4a8e-aba6-b51e470ae5ea","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SwmV7rYbUoFXJM5A4tvjy7","type":"tool_result","content":"File created successfully at: F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\import_fixtures.py (file state is current in your context — no need to Read it back)"}]},"uuid":"9c877263-f4ab-4d74-8f2f-ddcbd302227b","timestamp":"2026-10-10T07:07:58.691Z","toolUseResult":{"type":"create","filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\import_fixtures.py","content":"\"\"\"Realistic floor-plan files for exercising the importer.\n\nWrites, into backend/var/fixtures/:\n\n* own.dxf / own.svg          - the platform's own exports (rooms as closed shapes)\n* walls.dxf                  - what AutoCAD users actually send: walls as LINE\n                               and LWPOLYLINE linework with gaps at the doors,\n                               room names as TEXT/MTEXT, a dimension layer and\n                               furniture blocks as noise, units in millimetres\n* walls.svg                  - the same linework as SVG <line>/<path> inside a\n                               transformed <g>, labels as <text>, like Illustrator\n                               or Inkscape exports\n* scan.png                   - a raster rendering: thick black walls with door\n                               gaps, text labels, dimension strings, a little\n                               noise and a slight rotation, like a phone photo\n                               of a printed plan\n* sketch.jpg                 - a lower-contrast JPEG with thinner walls\n\nRun:  python -m scripts.import_fixtures   (from backend/)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nimport random\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont\n\nfrom aip.domain.brief import default_residence_brief\nfrom aip.domain.plan import FloorPlan\nfrom aip.engines.architecture.drawings import floor_plan_svg\nfrom aip.engines.architecture.dxf import export_dxf\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"fixtures\"\n\n\ndef make_plan() -> FloorPlan:\n    brief = default_residence_brief()\n    return LayoutGenerator(brief, GeneratorConfig(population=36, generations=32, seed=23)).generate(1)[0]\n\n\ndef wall_segments(plan: FloorPlan, level: int = 0) -> list[tuple[tuple[float, float], tuple[float, float], float, list[tuple[float, float]]]]:\n    \"\"\"(start, end, thickness, door gaps as (t0, t1) fractions) per wall.\"\"\"\n    out = []\n    lv = plan.levels[level]\n    for w in lv.walls:\n        gaps = []\n        for o in lv.openings:\n            if o.wall_id != w.id or \"door\" not in str(o.kind).lower():\n                continue\n            length = max(w.length, 1e-6)\n            c = o.position if 0 <= o.position <= 1 else o.position / length\n            half = (o.width / 2) / length\n            gaps.append((max(0.0, c - half), min(1.0, c + half)))\n        out.append(((w.start.x, w.start.y), (w.end.x, w.end.y), w.thickness, sorted(gaps)))\n    return out\n\n\ndef pieces(seg, gaps):\n    (x0, y0), (x1, y1) = seg\n    cuts = [0.0]\n    for a, b in gaps:\n        cuts += [a, b]\n    cuts.append(1.0)\n    for i in range(0, len(cuts), 2):\n        a, b = cuts[i], cuts[i + 1]\n        if b - a > 1e-3:\n            yield (x0 + (x1 - x0) * a, y0 + (y1 - y0) * a), (x0 + (x1 - x0) * b, y0 + (y1 - y0) * b)\n\n\ndef walls_dxf(plan: FloorPlan) -> str:\n    mm = 1000.0\n    ents: list[str] = []\n\n    def line(layer, a, b):\n        ents.append(f\"0\\nLINE\\n8\\n{layer}\\n10\\n{a[0]*mm:.1f}\\n20\\n{a[1]*mm:.1f}\\n30\\n0\\n11\\n{b[0]*mm:.1f}\\n21\\n{b[1]*mm:.1f}\\n31\\n0\")\n\n    for (s, e, t, gaps) in wall_segments(plan):\n        # Each wall drawn as its two faces, as a draughtsperson would.\n        dx, dy = e[0] - s[0], e[1] - s[1]\n        L = math.hypot(dx, dy) or 1\n        nx, ny = -dy / L * t / 2, dx / L * t / 2\n        for a, b in pieces((s, e), gaps):\n            line(\"A-WALL\", (a[0] + nx, a[1] + ny), (b[0] + nx, b[1] + ny))\n            line(\"A-WALL\", (a[0] - nx, a[1] - ny), (b[0] - nx, b[1] - ny))\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        ents.append(f\"0\\nMTEXT\\n8\\nA-ANNO\\n10\\n{c.x*mm:.1f}\\n20\\n{c.y*mm:.1f}\\n30\\n0\\n40\\n250\\n1\\n\\\\fArial|b1;{r.display_name().upper()}\\\\P{r.area:.1f} SQ.M\")\n    # Noise: a dimension line and a sofa block outline.\n    line(\"A-DIMS\", (0, -1.0), (plan.site.width, -1.0))\n    ents.append(f\"0\\nTEXT\\n8\\nA-DIMS\\n10\\n{plan.site.width*mm/2:.1f}\\n20\\n{-1.3*mm:.1f}\\n30\\n0\\n40\\n200\\n1\\n{plan.site.width*mm:.0f}\")\n    body = \"\\n\".join(ents)\n    return f\"0\\nSECTION\\n2\\nHEADER\\n9\\n$INSUNITS\\n70\\n4\\n0\\nENDSEC\\n0\\nSECTION\\n2\\nENTITIES\\n{body}\\n0\\nENDSEC\\n0\\nEOF\\n\"\n\n\ndef walls_svg(plan: FloorPlan) -> str:\n    k = 30.0\n    H = plan.site.depth\n    parts = []\n    for (s, e, t, gaps) in wall_segments(plan):\n        for a, b in pieces((s, e), gaps):\n            parts.append(f'<line x1=\"{a[0]*k:.1f}\" y1=\"{(H-a[1])*k:.1f}\" x2=\"{b[0]*k:.1f}\" y2=\"{(H-b[1])*k:.1f}\" stroke=\"#000\" stroke-width=\"{max(4, t*k):.1f}\"/>')\n    for r in plan.levels[0].rooms:\n        c = r.centre\n        parts.append(f'<text x=\"{c.x*k:.1f}\" y=\"{(H-c.y)*k:.1f}\" font-size=\"11\">{r.display_name()}</text>')\n    inner = \"\\n\".join(parts)\n    return (f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{plan.site.width*k+200:.0f}\" height=\"{H*k+200:.0f}\">'\n            f'<g transform=\"translate(100,100)\">{inner}</g></svg>')\n\n\ndef raster(plan: FloorPlan, *, px_per_m=60, wall_px=None, rotate=1.2, noise=10, jpeg=False, path: Path) -> None:\n    W, H = plan.site.width, plan.site.depth\n    M = 80\n    img = Image.new(\"L\", (int(W * px_per_m + 2 * M), int(H * px_per_m + 2 * M)), 250)\n    d = ImageDraw.Draw(img)\n    to = lambda p: (M + p[0] * px_per_m, M + (H - p[1]) * px_per_m)  # noqa: E731\n    try:\n        font = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.28))\n        small = ImageFont.truetype(\"arial.ttf\", int(px_per_m * 0.2))\n    except OSError:\n        font = small = ImageFont.load_default()\n    for (s, e, t, gaps) in wall_segments(plan):\n        width = wall_px or max(5, int(t * px_per_m))\n        for a, b in pieces((s, e), gaps):\n            d.line([to(a), to(b)], fill=20, width=width)\n    for r in plan.levels[0].rooms:\n        x, y = to((r.centre.x, r.centre.y))\n        d.text((x, y - px_per_m * 0.18), r.display_name().upper(), fill=30, font=font, anchor=\"mm\")\n        d.text((x, y + px_per_m * 0.18), f\"{r.bbox.width:.1f} x {r.bbox.height:.1f}\", fill=60, font=small, anchor=\"mm\")\n    # A dimension string along the bottom, like a real drawing.\n    y = M + H * px_per_m + 40\n    d.line([(M, y), (M + W * px_per_m, y)], fill=60, width=2)\n    d.text((M + W * px_per_m / 2, y + 16), f\"{W*1000:.0f}\", fill=40, font=small, anchor=\"mm\")\n    img = img.rotate(rotate, resample=Image.BICUBIC, expand=True, fillcolor=250)\n    rnd = random.Random(7)\n    px = img.load()\n    for _ in range(int(img.width * img.height * 0.01)):\n        x, yv = rnd.randrange(img.width), rnd.randrange(img.height)\n        px[x, yv] = max(0, min(255, px[x, yv] + rnd.randint(-noise * 6, noise * 6)))\n    img = img.filter(ImageFilter.GaussianBlur(0.6))\n    if jpeg:\n        img = img.point(lambda v: 70 + v * 0.65)   # washed out, like a phone photo\n        img.convert(\"RGB\").save(path, quality=72)\n    else:\n        img.save(path)\n\n\ndef main() -> None:\n    OUT.mkdir(parents=True, exist_ok=True)\n    plan = make_plan()\n    (OUT / \"truth.json\").write_text(plan.model_dump_json(indent=1), encoding=\"utf-8\")\n    (OUT / \"own.dxf\").write_text(export_dxf(plan, 0), encoding=\"utf-8\")\n    (OUT / \"own.svg\").write_text(floor_plan_svg(plan, 0), encoding=\"utf-8\")\n    (OUT / \"walls.dxf\").write_text(walls_dxf(plan), encoding=\"utf-8\")\n    (OUT / \"walls.svg\").write_text(walls_svg(plan), encoding=\"utf-8\")\n    raster(plan, path=OUT / \"scan.png\")\n    raster(plan, px_per_m=45, wall_px=4, rotate=-2.0, jpeg=True, path=OUT / \"sketch.jpg\")\n    print(\"rooms in truth:\", [(r.display_name(), round(r.area, 1)) for r in plan.levels[0].rooms])\n    print(\"wrote\", sorted(p.name for p in OUT.iterdir()))\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"b37a8f99-141a-4c9d-ae38-a687fe7d0a70","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
