{"parentUuid":"5b2a60ce-1f7a-445e-b0cf-16d39dd85e14","isSidechain":false,"promptId":"cde90b88-60f3-4a8e-aba6-b51e470ae5ea","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016bzkRoMmHYQmrpG3k9UzCi","type":"tool_result","content":"29   18x24   L2 5bhk road E    7.4s  long_room:2 too_much_corridor:1 stairs_misaligned:1\n\nclean 1/30   defect frequency: {'too_much_corridor': 20, 'long_room': 16, 'stairs_misaligned': 15, 'guardrail': 13, 'cut_up': 2}","is_error":false}]},"uuid":"a2df114b-d3bf-4f08-8ca5-0e9975e75162","timestamp":"2026-10-10T07:17:11.167Z","toolUseResult":{"stdout":"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py","hunks":[{"oldStart":1,"oldLines":159,"newStart":1,"newLines":160,"lines":["-\"\"\"Generate plans across a spread of realistic briefs and score each for the","-defects a client spots in the first ten seconds.","-","-Run:  python -m scripts.plan_sweep [--n 30] [--svg]   (from backend/)","-","-Writes var/sweep/report.json and, with --svg, one floor-plan SVG per level so","-the worst plans can be looked at, not just counted.","-\"\"\"","-","-from __future__ import annotations","-","-import argparse","-import json","-import random","-import time","-from collections import Counter","-from pathlib import Path","-","-from shapely.geometry import Polygon","-from shapely.ops import unary_union","-","-from aip.api.schemas import SimpleBriefRequest","-from aip.domain.geometry import Direction","-from aip.domain.plan import FloorPlan, RoomType","-from aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator","-","-OUT = Path(__file__).resolve().parent.parent / \"var\" / \"sweep\"","-","-PUBLIC = {RoomType.LIVING, RoomType.DINING, RoomType.KITCHEN}","-WET = {RoomType.BATHROOM, RoomType.TOILET} if hasattr(RoomType, \"TOILET\") else {RoomType.BATHROOM}","-","-","-def briefs(n: int, seed: int = 11) -> list[SimpleBriefRequest]:","-    rng = random.Random(seed)","-    out = []","-    shapes = [(9, 12), (9, 15), (10, 14), (12, 18), (12, 20), (15, 20), (15, 25), (18, 24), (20, 30), (24, 18), (30, 15)]","-    for i in range(n):","-        w, d = rng.choice(shapes)","-        levels = rng.choice([1, 1, 2, 2, 2, 3])","-        beds = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5])","-        out.append(SimpleBriefRequest(","-            project_name=f\"sweep {i}\",","-            plot_width=w, plot_depth=d, levels=levels, bedrooms=beds,","-            bathrooms=max(1, min(beds + rng.choice([-1, 0, 0, 1]), 6)),","-            road_direction=rng.choice(list(Direction)),","-            vastu=rng.choice([\"ignore\", \"advisory\", \"balanced\", \"strict\"]),","-            amenities=rng.sample([\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"], rng.randint(1, 4)),","-            occupant_elders=rng.choice([0, 0, 1, 2]),","-            setback_front=rng.choice([1.5, 2.0, 3.0]), setback_rear=1.5,","-            setback_left=rng.choice([1.0, 1.2]), setback_right=rng.choice([1.0, 1.2]),","-        ))","-    return out","-","-","-def defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:","-    d: dict[str, list[str]] = {}","-","-    def add(kind: str, msg: str) -> None:","-        d.setdefault(kind, []).append(msg)","-","-    for msg in gen._sanity(plan):  # noqa: SLF001 - the generator's own guardrail","-        add(\"guardrail\", msg)","-","-    for level in plan.levels:","-        rooms = level.rooms","-        by_id = {r.id: r for r in rooms}","-        doors = [o for w in level.walls for o in w.openings if o.kind.is_door]","-        windows = {r.id: 0 for r in rooms}","-        door_count = Counter()","-        for w in level.walls:","-            for o in w.openings:","-                if o.kind.is_door and o.connects:","-                    for rid in o.connects:","-                        door_count[rid] += 1","-                elif not o.kind.is_door:","-                    for rid in w.rooms:","-                        if rid in windows:","-                            windows[rid] += 1","-        tag = f\"L{level.index}\"","-        for r in rooms:","-            name = r.display_name()","-            if r.type.is_habitable and windows.get(r.id, 0) == 0:","-                add(\"no_window\", f\"{tag} {name}\")","-            if not r.type.is_outdoor and door_count[r.id] == 0 and len(rooms) > 1:","-                add(\"no_door\", f\"{tag} {name}\")","-            if door_count[r.id] > 3 and not r.type.is_circulation:","-                add(\"cut_up\", f\"{tag} {name} has {door_count[r.id]} doors\")","-            if r.type in (RoomType.LIVING, RoomType.MASTER_BEDROOM, RoomType.BEDROOM, RoomType.DINING) and r.bbox.aspect_ratio > 2.2:","-                add(\"long_room\", f\"{tag} {name} {r.bbox.aspect_ratio:.1f}:1\")","-        # A bathroom whose only door opens into the kitchen, living or dining room.","-        for o in doors:","-            if not o.connects:","-                continue","-            a, b = (by_id.get(x) for x in o.connects)","-            if a and b:","-                pair = {a.type, b.type}","-                if pair & WET and pair & PUBLIC:","-                    add(\"wc_off_public\", f\"{tag} {a.display_name()}-{b.display_name()}\")","-        # Holes and slivers inside the building: space nobody can use.","-        polys = [Polygon([(p.x, p.y) for p in r.polygon]).buffer(0) for r in rooms if len(r.polygon) >= 3]","-        if polys:","-            union = unary_union(polys)","-            hull = union.envelope","-            hole_area = hull.area - union.area","-            if hole_area > 0.08 * hull.area:","-                add(\"dead_space\", f\"{tag} {hole_area:.1f} m2 ({hole_area / hull.area:.0%}) of the footprint unused\")","-        circ = sum(r.area for r in rooms if r.type.is_circulation)","-        total = sum(r.area for r in rooms) or 1","-        if circ / total > 0.18:","-            add(\"too_much_corridor\", f\"{tag} {circ / total:.0%}\")","-    # Stairs stacked on top of each other.","-    stairs = [[r for r in lv.rooms if r.type == RoomType.STAIRCASE] for lv in plan.levels]","-    if len(plan.levels) > 1 and all(len(s) == 1 for s in stairs):","-        c0 = stairs[0][0].centre","-        for s in stairs[1:]:","-            if s[0].centre.distance_to(c0) > 0.6:","-                add(\"stairs_misaligned\", f\"offset {s[0].centre.distance_to(c0):.1f} m\")","-    return d","-","-","-def main() -> None:","-    ap = argparse.ArgumentParser()","-    ap.add_argument(\"--n\", type=int, default=30)","-    ap.add_argument(\"--svg\", action=\"store_true\")","-    args = ap.parse_args()","-    OUT.mkdir(parents=True, exist_ok=True)","-    rows = []","-    tally: Counter[str] = Counter()","-    for i, req in enumerate(briefs(args.n)):","-        brief = req.to_brief()","-        gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))","-        t0 = time.perf_counter()","-        try:","-            plan = gen.generate(1)[0]","-        except Exception as exc:  # noqa: BLE001","-            rows.append({\"i\": i, \"error\": f\"{type(exc).__name__}: {exc}\"})","-            tally[\"crash\"] += 1","-            print(f\"{i:2d} CRASH {exc}\")","-            continue","-        secs = time.perf_counter() - t0","-        d = defects(plan, gen)","-        for k in d:","-            tally[k] += 1","-        rows.append({\"i\": i, \"plot\": [req.plot_width, req.plot_depth], \"levels\": req.levels,","-                     \"beds\": req.bedrooms, \"road\": req.road_direction.value, \"secs\": round(secs, 1),","-                     \"defects\": d})","-        flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"","-        print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}\")","-        if args.svg:","-            from aip.engines.architecture.drawings import floor_plan_svg","-            for lv in plan.levels:","-                (OUT / f\"p{i:02d}_L{lv.index}.svg\").write_text(floor_plan_svg(plan, lv.index), encoding=\"utf-8\")","-    clean = sum(1 for r in rows if not r.get(\"defects\") and \"error\" not in r)","-    print(f\"\\nclean {clean}/{len(rows)}   defect frequency: {dict(tally.most_common())}\")","-    (OUT / \"report.json\").write_text(json.dumps({\"tally\": tally, \"rows\": rows}, indent=1, default=str), encoding=\"utf-8\")","-","-","-if __name__ == \"__main__\":","-    main()","+\"\"\"Generate plans across a spread of realistic briefs and score each for the\r","+defects a client spots in the first ten seconds.\r","+\r","+Run:  python -m scripts.plan_sweep [--n 30] [--svg]   (from backend/)\r","+\r","+Writes var/sweep/report.json and, with --svg, one floor-plan SVG per level so\r","+the worst plans can be looked at, not just counted.\r","+\"\"\"\r","+\r","+from __future__ import annotations\r","+\r","+import argparse\r","+import json\r","+import random\r","+import time\r","+from collections import Counter\r","+from pathlib import Path\r","+\r","+from shapely.geometry import Polygon\r","+from shapely.ops import unary_union\r","+\r","+from aip.api.schemas import SimpleBriefRequest\r","+from aip.domain.geometry import Direction\r","+from aip.domain.plan import FloorPlan, RoomType\r","+from aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\r","+\r","+OUT = Path(__file__).resolve().parent.parent / \"var\" / \"sweep\"\r","+\r","+PUBLIC = {RoomType.LIVING, RoomType.DINING, RoomType.KITCHEN}\r","+WET = {RoomType.BATHROOM, RoomType.TOILET} if hasattr(RoomType, \"TOILET\") else {RoomType.BATHROOM}\r","+\r","+\r","+def briefs(n: int, seed: int = 11) -> list[SimpleBriefRequest]:\r","+    rng = random.Random(seed)\r","+    out = []\r","+    shapes = [(9, 12), (9, 15), (10, 14), (12, 18), (12, 20), (15, 20), (15, 25), (18, 24), (20, 30), (24, 18), (30, 15)]\r","+    for i in range(n):\r","+        w, d = rng.choice(shapes)\r","+        levels = rng.choice([1, 1, 2, 2, 2, 3])\r","+        beds = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5])\r","+        out.append(SimpleBriefRequest(\r","+            project_name=f\"sweep {i}\",\r","+            plot_width=w, plot_depth=d, levels=levels, bedrooms=beds,\r","+            bathrooms=max(1, min(beds + rng.choice([-1, 0, 0, 1]), 6)),\r","+            road_direction=rng.choice([Direction(v) for v in (\"N\", \"NE\", \"E\", \"SE\", \"S\", \"SW\", \"W\", \"NW\")]),\r","+            vastu=rng.choice([\"ignore\", \"advisory\", \"balanced\", \"strict\"]),\r","+            amenities=rng.sample([\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"], rng.randint(1, 4)),\r","+            occupant_elders=rng.choice([0, 0, 1, 2]),\r","+            setback_front=rng.choice([1.5, 2.0, 3.0]), setback_rear=1.5,\r","+            setback_left=rng.choice([1.0, 1.2]), setback_right=rng.choice([1.0, 1.2]),\r","+        ))\r","+    return out\r","+\r","+\r","+def defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:\r","+    d: dict[str, list[str]] = {}\r","+\r","+    def add(kind: str, msg: str) -> None:\r","+        d.setdefault(kind, []).append(msg)\r","+\r","+    for msg in gen._sanity(plan):  # noqa: SLF001 - the generator's own guardrail\r","+        add(\"guardrail\", msg)\r","+\r","+    for level in plan.levels:\r","+        rooms = level.rooms\r","+        by_id = {r.id: r for r in rooms}\r","+        doors = [o for w in level.walls for o in w.openings if o.kind.is_door]\r","+        windows = {r.id: 0 for r in rooms}\r","+        door_count = Counter()\r","+        for w in level.walls:\r","+            for o in w.openings:\r","+                if o.kind.is_door and o.connects:\r","+                    for rid in o.connects:\r","+                        door_count[rid] += 1\r","+                elif not o.kind.is_door:\r","+                    for rid in w.rooms:\r","+                        if rid in windows:\r","+                            windows[rid] += 1\r","+        tag = f\"L{level.index}\"\r","+        for r in rooms:\r","+            name = r.display_name()\r","+            if r.type.is_habitable and windows.get(r.id, 0) == 0:\r","+                add(\"no_window\", f\"{tag} {name}\")\r","+            if not r.type.is_outdoor and door_count[r.id] == 0 and len(rooms) > 1:\r","+                add(\"no_door\", f\"{tag} {name}\")\r","+            if door_count[r.id] > 3 and not r.type.is_circulation:\r","+                add(\"cut_up\", f\"{tag} {name} has {door_count[r.id]} doors\")\r","+            if r.type in (RoomType.LIVING, RoomType.MASTER_BEDROOM, RoomType.BEDROOM, RoomType.DINING) and r.bbox.aspect_ratio > 2.2:\r","+                add(\"long_room\", f\"{tag} {name} {r.bbox.aspect_ratio:.1f}:1\")\r","+        # A bathroom whose only door opens into the kitchen, living or dining room.\r","+        for o in doors:\r","+            if not o.connects:\r","+                continue\r","+            a, b = (by_id.get(x) for x in o.connects)\r","+            if a and b:\r","+                pair = {a.type, b.type}\r","+                if pair & WET and pair & PUBLIC:\r","+                    add(\"wc_off_public\", f\"{tag} {a.display_name()}-{b.display_name()}\")\r","+        # Holes and slivers inside the building: space nobody can use.\r","+        polys = [Polygon([(p.x, p.y) for p in r.polygon]).buffer(0) for r in rooms if len(r.polygon) >= 3]\r","+        if polys:\r","+            union = unary_union(polys)\r","+            hull = union.envelope\r","+            hole_area = hull.area - union.area\r","+            if hole_area > 0.08 * hull.area:\r","+                add(\"dead_space\", f\"{tag} {hole_area:.1f} m2 ({hole_area / hull.area:.0%}) of the footprint unused\")\r","+        # Passages only: a foyer is a room and a staircase is unavoidable.\r","+        circ = sum(r.area for r in rooms if r.type in (RoomType.CORRIDOR, RoomType.LOBBY))\r","+        total = sum(r.area for r in rooms) or 1\r","+        if circ / total > 0.12:\r","+            add(\"too_much_corridor\", f\"{tag} {circ / total:.0%}\")\r","+    # Stairs stacked on top of each other.\r","+    stairs = [[r for r in lv.rooms if r.type == RoomType.STAIRCASE] for lv in plan.levels]\r","+    if len(plan.levels) > 1 and all(len(s) == 1 for s in stairs):\r","+        c0 = stairs[0][0].centre\r","+        for s in stairs[1:]:\r","+            if s[0].centre.distance_to(c0) > 0.6:\r","+                add(\"stairs_misaligned\", f\"offset {s[0].centre.distance_to(c0):.1f} m\")\r","+    return d\r","+\r","+\r","+def main() -> None:\r","+    ap = argparse.ArgumentParser()\r","+    ap.add_argument(\"--n\", type=int, default=30)\r","+    ap.add_argument(\"--svg\", action=\"store_true\")\r","+    args = ap.parse_args()\r","+    OUT.mkdir(parents=True, exist_ok=True)\r","+    rows = []\r","+    tally: Counter[str] = Counter()\r","+    for i, req in enumerate(briefs(args.n)):\r","+        brief = req.to_brief()\r","+        gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))\r","+        t0 = time.perf_counter()\r","+        try:\r","+            plan = gen.generate(1)[0]\r","+        except Exception as exc:  # noqa: BLE001\r","+            rows.append({\"i\": i, \"error\": f\"{type(exc).__name__}: {exc}\"})\r","+            tally[\"crash\"] += 1\r","+            print(f\"{i:2d} CRASH {exc}\")\r","+            continue\r","+        secs = time.perf_counter() - t0\r","+        d = defects(plan, gen)\r","+        for k in d:\r","+            tally[k] += 1\r","+        rows.append({\"i\": i, \"plot\": [req.plot_width, req.plot_depth], \"levels\": req.levels,\r","+                     \"beds\": req.bedrooms, \"road\": req.road_direction.value, \"secs\": round(secs, 1),\r","+                     \"defects\": d})\r","+        flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"\r","+        print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}\")\r","+        if args.svg:\r","+            from aip.engines.architecture.drawings import floor_plan_svg\r","+            for lv in plan.levels:\r","+                (OUT / f\"p{i:02d}_L{lv.index}.svg\").write_text(floor_plan_svg(plan, lv.index), encoding=\"utf-8\")\r","+    clean = sum(1 for r in rows if not r.get(\"defects\") and \"error\" not in r)\r","+    print(f\"\\nclean {clean}/{len(rows)}   defect frequency: {dict(tally.most_common())}\")\r","+    (OUT / \"report.json\").write_text(json.dumps({\"tally\": tally, \"rows\": rows}, indent=1, default=str), encoding=\"utf-8\")\r","+\r","+\r","+if __name__ == \"__main__\":\r","+    main()"]}]}],"moreFiles":0,"changedFiles":["F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py"],"shared":true}},"sourceToolAssistantUUID":"5b2a60ce-1f7a-445e-b0cf-16d39dd85e14","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
