"f1ef276e-2bd5-4bac-8f47-88217a69ce34","timestamp":"2026-10-10T08:13:22.554Z","toolUseResult":{"stdout":"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py","hunks":[{"oldStart":52,"oldLines":6,"newStart":52,"newLines":32,"lines":["     return out\r"," \r"," \r","+def large_briefs() -> list[SimpleBriefRequest]:\r","+    \"\"\"Generous plots: the house must grow to the site it is given, not sit in a corner of it.\"\"\"\r","+    common = dict(road_direction=Direction(\"N\"), vastu=\"balanced\", occupant_elders=1,\r","+                  amenities=[\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"],\r","+                  setback_front=3.0, setback_rear=1.5, setback_left=1.2, setback_right=1.2)\r","+    return [\r","+        SimpleBriefRequest(project_name=\"large 40x60\", plot_width=40, plot_depth=60, levels=4,\r","+                           bedrooms=6, bathrooms=6, **common),\r","+        SimpleBriefRequest(project_name=\"large 30x40\", plot_width=30, plot_depth=40, levels=2,\r","+                           bedrooms=4, bathrooms=4, **common),\r","+    ]\r","+\r","+\r","+def footprint_report(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, float]:\r","+    \"\"\"How much of the plot's allowance the floor plate uses, and the largest room against its cap.\"\"\"\r","+    from aip.engines.architecture.feasibility import luxury_max\r","+\r","+    site = plan.site\r","+    env = gen._envelope  # noqa: SLF001\r","+    allowed = min(gen._footprint_cap() or env.area, site.max_footprint)  # noqa: SLF001\r","+    over = [(r.display_name(), r.area, luxury_max(r.type)) for r in plan.all_rooms\r","+            if luxury_max(r.type) is not None and r.area > luxury_max(r.type) + 0.5]\r","+    return {\"footprint_m2\": round(env.area, 1), \"allowed_m2\": round(allowed, 1),\r","+            \"fill\": round(env.area / allowed, 3), \"rooms_over_cap\": len(over)}\r","+\r","+\r"," def defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:\r","     d: dict[str, list[str]] = {}\r"," \r"]},{"oldStart":123,"oldLines":17,"newStart":149,"newLines":18,"lines":["     ap = argparse.ArgumentParser()\r","     ap.add_argument(\"--n\", type=int, default=30)\r","     ap.add_argument(\"--svg\", action=\"store_true\")\r","+    ap.add_argument(\"--large\", action=\"store_true\", help=\"run the generous-plot cases instead\")\r","     args = ap.parse_args()\r","     OUT.mkdir(parents=True, exist_ok=True)\r","     rows = []\r","     tally: Counter[str] = Counter()\r","     infeasible = 0\r","     slowest = 0.0\r","-    for i, req in enumerate(briefs(args.n)):\r","+    for i, req in enumerate(large_briefs() if args.large else briefs(args.n)):\r","         brief = req.to_brief()\r","         t0 = time.perf_counter()\r","         try:\r","-            gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))\r","+            gen = LayoutGenerator(brief, GeneratorConfig(seed=(900 if args.large else 100) + i))\r","             plan = gen.generate(1)[0]\r","         except InfeasibleBriefError as exc:\r","             # The typed refusal is the right answer for a programme that cannot\r"]},{"oldStart":161,"oldLines":6,"newStart":188,"newLines":10,"lines":["                      \"advisories\": plan.metadata.get(\"advisories\", []), \"defects\": d})\r","         flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"\r","         print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels}->{len(plan.levels)} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}{advised}\")\r","+        if args.large:\r","+            print(\"   footprint\", footprint_report(plan, gen))\r","+            for adv in plan.metadata.get(\"advisories\", []):\r","+                print(\"   -\", adv)\r","         if args.svg:\r","             from aip.engines.architecture.drawings import floor_plan_svg\r","             for lv in plan.levels:"]}]}],"moreFiles":1,"changedFiles":["F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\architecture\\layout.py","F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py"],"shared":true}},"sourceToolAssistantUUID":"49626c8f-3a8e-4731-87f0-10025148d9c1","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
