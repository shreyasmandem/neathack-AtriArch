drop-shadow(0 24px 48px rgba(0, 0, 0, 0.55)); }\r","-.plate.is-zoomed { place-items: start center; }\r","-.plate.is-zoomed svg { max-height: none; width: 100%; }\r","+.plate { overflow: hidden; touch-action: none; cursor: grab; }\r","+.plate.is-panning { cursor: grabbing; }\r","+.plate svg, .plate img { transform-origin: 50% 50%; will-change: transform; user-select: none; -webkit-user-drag: none; }\r","+.zoom-step { width: 30px; padding: 0; font-size: 16px; letter-spacing: 0; }\r","+#zoom-val { min-width: 52px; }\r"," .plate .plate__ghost { width: 100%; height: 100%; object-fit: contain; }\r"," .plate__caption { flex: 0 0 auto; margin: 0; padding: 12px var(--gut); border-top: 1px solid var(--rule); font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cream-3); }\r"," \r"]}]},{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\studio.js","hunks":[{"oldStart":355,"oldLines":10,"newStart":355,"newLines":7,"lines":["   });\r","   $(\"dl-svg\").addEventListener(\"click\", downloadSheet);\r","   $(\"dl-dxf\").addEventListener(\"click\", downloadDxf);\r","-  $(\"zoom\").addEventListener(\"click\", () => {\r","-    const on = $(\"plate\").classList.toggle(\"is-zoomed\");\r","-    $(\"zoom\").textContent = on ? \"Fit to frame\" : \"Actual size\";\r","-  });\r","+  initPlate();\r","   document.querySelectorAll(\".view-tab\").forEach((t) =>\r","     t.addEventListener(\"click\", () => showView(t.dataset.view)));\r"," \r"]},{"oldStart":1162,"oldLines":6,"newStart":1159,"newLines":70,"lines":["   }\r"," }\r"," \r","+/* ── drawings: pan and zoom ─────────────────────────────────────────── */\r","+\r","+// Scroll to zoom toward the pointer, drag to pan, double-click to step in\r","+// or back to fit. The drawing moves; the plate stays put.\r","+const plateView = { z: 1, x: 0, y: 0, drag: null };\r","+\r","+function applyPlate(animate = false) {\r","+  const art = $(\"plate\")?.querySelector(\"svg, img\");\r","+  if (art) {\r","+    art.style.transition = animate ? \"transform .45s cubic-bezier(.16,1,.3,1)\" : \"none\";\r","+    art.style.transform = `translate(${plateView.x}px, ${plateView.y}px) scale(${plateView.z})`;\r","+  }\r","+  setText(\"zoom-val\", `${Math.round(plateView.z * 100)}%`);\r","+}\r","+\r","+function zoomPlate(z, cx = 0, cy = 0, animate = false) {\r","+  const next = Math.max(0.5, Math.min(5, z));\r","+  const f = next / plateView.z;\r","+  plateView.x = cx - (cx - plateView.x) * f;\r","+  plateView.y = cy - (cy - plateView.y) * f;\r","+  plateView.z = next;\r","+  applyPlate(animate);\r","+}\r","+\r","+function resetPlate(animate = true) {\r","+  Object.assign(plateView, { z: 1, x: 0, y: 0 });\r","+  applyPlate(animate);\r","+}\r","+\r","+function initPlate() {\r","+  const plate = $(\"plate\");\r","+  if (!plate) return;\r","+  const centre = (e) => {\r","+    const r = plate.getBoundingClientRect();\r","+    return [e.clientX - r.left - r.width / 2, e.clientY - r.top - r.height / 2];\r","+  };\r","+  plate.addEventListener(\"wheel\", (e) => {\r","+    e.preventDefault();\r","+    zoomPlate(plateView.z * (e.deltaY < 0 ? 1.15 : 1 / 1.15), ...centre(e));\r","+  }, { passive: false });\r","+  plate.addEventListener(\"pointerdown\", (e) => {\r","+    if (e.button !== 0) return;\r","+    plateView.drag = { x: e.clientX - plateView.x, y: e.clientY - plateView.y };\r","+    plate.setPointerCapture(e.pointerId);\r","+    plate.classList.add(\"is-panning\");\r","+  });\r","+  plate.addEventListener(\"pointermove\", (e) => {\r","+    if (!plateView.drag) return;\r","+    plateView.x = e.clientX - plateView.drag.x;\r","+    plateView.y = e.clientY - plateView.drag.y;\r","+    applyPlate();\r","+  });\r","+  const end = () => { plateView.drag = null; plate.classList.remove(\"is-panning\"); };\r","+  plate.addEventListener(\"pointerup\", end);\r","+  plate.addEventListener(\"pointercancel\", end);\r","+  plate.addEventListener(\"dblclick\", (e) => {\r","+    if (plateView.z > 1.05) resetPlate();\r","+    else zoomPlate(2, ...centre(e), true);\r","+  });\r","+  $(\"zoom-in\")?.addEventListener(\"click\", () => zoomPlate(plateView.z * 1.3, 0, 0, true));\r","+  $(\"zoom-out\")?.addEventListener(\"click\", () => zoomPlate(plateView.z / 1.3, 0, 0, true));\r","+  $(\"zoom-val\")?.addEventListener(\"click\", () => resetPlate());\r","+}\r","+\r"," async function loadSheet(key) {\r","   S.sheet = key;\r","   buildSheetTabs();\r"]},{"oldStart":1177,"oldLines":6,"newStart":1238,"newLines":7,"lines":["     const text = await r.text();\r","     if (S.sheet !== key) return;   // another sheet was asked for meanwhile\r","     plate.innerHTML = text;\r","+    resetPlate(false);\r","     const fresh = plate.querySelector(\"svg\");\r","     if (fresh && ghost && !reducedMotion()) {\r","       fresh.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, easing: \"ease-out\" });"]}]}],"moreFiles":0,"changedFiles":["F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\index.html","F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\rabbit.css","F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\studio.js"]}},"sourceToolAssistantUUID":"73262334-9dc2-4707-82c7-04af60692d8b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.293","gitBranch":"main","slug":"fluttering-mapping-sloth"}
