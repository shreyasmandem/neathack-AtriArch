{"parentUuid":"8012c163-8aa3-4057-a720-bc0b3816e220","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfsEAK8jXUqRf9dCmu3qy","type":"message","role":"assistant","content":[{"type":"text","text":"Writing the new index.html (brief, upload, run shell, review) from scratch."}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":866,"cache_read_input_tokens":456147,"output_tokens":8517,"output_tokens_details":{"thinking_tokens":39},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":866,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8517,"cache_read_input_tokens":456147,"cache_creation_input_tokens":866,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":866},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":1,"requestId":"req_011CfsEAJn9gQ4H7KsdBPJMB","attributionSkill":"impeccable","type":"assistant","uuid":"1568e225-72d3-4437-9ed7-863aa9dbf9b2","timestamp":"2026-10-09T19:37:44.364Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.293","gitBranch":"main","slug":"fluttering-mapping-sloth"}
{"parentUuid":"1568e225-72d3-4437-9ed7-863aa9dbf9b2","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CfsEAK8jXUqRf9dCmu3qy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0114bHgFCuSRoZwJAC83J3FR","name":"Write","input":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\index.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Atri Arch Studio</title>\n<meta name=\"description\" content=\"Brief a house, watch a studio of architects and thirteen specialists design it, and defend the scheme they choose.\">\n<meta name=\"theme-color\" content=\"#0b0a09\">\n<link rel=\"preload\" href=\"fonts/Archivo-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<link rel=\"preload\" href=\"fonts/Geist-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<script type=\"importmap\">{\"imports\":{\"three\":\"./vendor/three/three.module.min.js\",\"three/addons/\":\"./vendor/three/addons/\"}}</script>\n<link rel=\"stylesheet\" href=\"rabbit.css?v=r1\">\n</head>\n<body data-phase=\"compose\" data-mode=\"brief\">\n\n<div class=\"grain\" aria-hidden=\"true\"></div>\n<a class=\"skip\" href=\"#main\">Skip to the content</a>\n\n<!-- ═══ HEADER ═══ -->\n<header class=\"bar\">\n  <button type=\"button\" class=\"wordmark\" id=\"home\" aria-label=\"Atri Arch, back to the brief\">\n    <img src=\"logo_emblem.png\" alt=\"\" width=\"28\" height=\"28\">\n    <span>Atri Arch</span>\n  </button>\n\n  <div class=\"bar__mid\">\n    <div class=\"schemes\" id=\"schemes\" role=\"tablist\" aria-label=\"Schemes\"></div>\n  </div>\n\n  <nav class=\"views\" id=\"views\" aria-label=\"Views\">\n    <button type=\"button\" class=\"view-tab is-on\" data-view=\"drawings\">Drawings</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"model\">3D</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"vastu\">Vastu</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"cost\">Cost</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"interior\">Interior</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"report\">Report</button>\n  </nav>\n\n  <div class=\"bar__end\">\n    <p class=\"engine\" aria-live=\"polite\"><i id=\"engine-dot\" data-tone=\"running\"></i><span id=\"engine-note\">Connecting</span></p>\n    <button type=\"button\" class=\"btn btn--line\" id=\"restart\" hidden>New brief</button>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<!-- ═══ BRIEF ═══ -->\n<section class=\"compose\" id=\"compose\" aria-label=\"The brief\">\n\n  <div class=\"compose__title\">\n    <h1 class=\"headline\" id=\"headline\">\n      <span class=\"headline__soft\">A home on</span>\n      <span class=\"headline__hard\" id=\"hl-plot\">12 × 18 m</span>\n      <span class=\"headline__soft\">facing <span id=\"hl-road\">north</span>,</span>\n      <span class=\"headline__hard headline__hard--sm\" id=\"hl-prog\">3 bedrooms, 2 storeys</span>\n    </h1>\n\n    <figure class=\"plotfig\" aria-label=\"The plot, drawn to scale\">\n      <svg id=\"plot-svg\" viewBox=\"0 0 420 340\" role=\"img\" aria-labelledby=\"plot-cap\"></svg>\n      <figcaption id=\"plot-cap\">Plot, setbacks and road, drawn to scale from the brief.</figcaption>\n    </figure>\n  </div>\n\n  <div class=\"compose__sheet\">\n    <div class=\"modes\" id=\"mode-switch\" role=\"tablist\" aria-label=\"How to begin\">\n      <button type=\"button\" class=\"mode-tab\" role=\"tab\" data-mode=\"brief\" aria-selected=\"true\">Design from a brief</button>\n      <button type=\"button\" class=\"mode-tab\" role=\"tab\" data-mode=\"upload\" aria-selected=\"false\">Review a plan I have</button>\n    </div>\n\n    <!-- The brief, as a specification sheet -->\n    <form id=\"brief\" class=\"spec\" novalidate>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-site\">\n        <h2 class=\"spec__h\" id=\"g-site\">Site</h2>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Plot</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num\"><input type=\"number\" id=\"inp-plot-width\" name=\"plot_width\" value=\"12\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot width, east to west, in metres\"><i>m wide</i></label>\n            <span class=\"times\" aria-hidden=\"true\">×</span>\n            <label class=\"num\"><input type=\"number\" id=\"inp-plot-depth\" name=\"plot_depth\" value=\"18\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot depth, north to south, in metres\"><i>m deep</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\" id=\"k-road\">Road on the</span>\n          <div class=\"row__v\">\n            <div class=\"rose\" id=\"direction-grid\" role=\"radiogroup\" aria-labelledby=\"k-road\">\n              <label class=\"dir-radio\" data-val=\"NW\"><input type=\"radio\" name=\"road_direction\" value=\"NW\"><span>NW</span></label>\n              <label class=\"dir-radio\" data-val=\"N\"><input type=\"radio\" name=\"road_direction\" value=\"N\" checked><span>N</span></label>\n              <label class=\"dir-radio\" data-val=\"NE\"><input type=\"radio\" name=\"road_direction\" value=\"NE\"><span>NE</span></label>\n              <label class=\"dir-radio\" data-val=\"W\"><input type=\"radio\" name=\"road_direction\" value=\"W\"><span>W</span></label>\n              <span class=\"rose__c\" aria-hidden=\"true\"></span>\n              <label class=\"dir-radio\" data-val=\"E\"><input type=\"radio\" name=\"road_direction\" value=\"E\"><span>E</span></label>\n              <label class=\"dir-radio\" data-val=\"SW\"><input type=\"radio\" name=\"road_direction\" value=\"SW\"><span>SW</span></label>\n              <label class=\"dir-radio\" data-val=\"S\"><input type=\"radio\" name=\"road_direction\" value=\"S\"><span>S</span></label>\n              <label class=\"dir-radio\" data-val=\"SE\"><input type=\"radio\" name=\"road_direction\" value=\"SE\"><span>SE</span></label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Setbacks</span>\n          <div class=\"row__v row__v--trio\">\n            <label class=\"num\"><input type=\"number\" name=\"setback_front\" value=\"2.5\" step=\"0.5\" min=\"1\" aria-label=\"Front setback in metres\"><i>m front</i></label>\n            <label class=\"num\"><input type=\"number\" name=\"setback_rear\" value=\"1.5\" step=\"0.5\" min=\"1\" aria-label=\"Rear setback in metres\"><i>m rear</i></label>\n            <label class=\"num\"><input type=\"number\" name=\"setback_side\" value=\"1.2\" step=\"0.2\" min=\"1\" aria-label=\"Side setbacks in metres\"><i>m sides</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-levels\">Storeys</label>\n          <div class=\"row__v\">\n            <select name=\"levels\" id=\"inp-levels\">\n              <option value=\"1\">Ground only</option>\n              <option value=\"2\" selected>Ground + 1</option>\n              <option value=\"3\">Ground + 2</option>\n              <option value=\"4\">Stilt + 3</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-locality\">City</label>\n          <div class=\"row__v\"><input type=\"text\" name=\"locality\" id=\"inp-locality\" value=\"Bengaluru, Karnataka\" maxlength=\"120\" class=\"text\"></div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-prog\">\n        <h2 class=\"spec__h\" id=\"g-prog\">Programme</h2>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Rooms</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer bedroom\">−</button><input type=\"number\" name=\"bedrooms\" id=\"inp-bedrooms\" value=\"3\" min=\"1\" max=\"8\" aria-label=\"Bedrooms\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more bedroom\">+</button><i>bedrooms</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer bathroom\">−</button><input type=\"number\" name=\"bathrooms\" id=\"inp-bathrooms\" value=\"3\" min=\"1\" max=\"8\" aria-label=\"Bathrooms\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more bathroom\">+</button><i>bathrooms</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-kitchen\">Kitchen</label>\n          <div class=\"row__v\">\n            <select name=\"kitchen_type\" id=\"inp-kitchen\">\n              <option value=\"open_modular\" selected>Open modular</option>\n              <option value=\"closed\">Closed, traditional</option>\n              <option value=\"wet_dry\">Wet and dry, separate</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Also</span>\n          <div class=\"row__v\">\n            <div class=\"toggles\">\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_pooja\" value=\"1\" checked><span>Pooja room</span></label>\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_dining\" value=\"1\" checked><span>Dining</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_study\" value=\"1\"><span>Study</span></label>\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_utility\" value=\"1\" checked><span>Utility</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_balcony\" value=\"1\"><span>Balcony</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_parking\" value=\"1\"><span>Parking</span></label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Living here</span>\n          <div class=\"row__v row__v--trio\">\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer adult\">−</button><input type=\"number\" name=\"occupant_adults\" value=\"2\" min=\"1\" max=\"10\" aria-label=\"Adults\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more adult\">+</button><i>adults</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer child\">−</button><input type=\"number\" name=\"occupant_children\" value=\"1\" min=\"0\" max=\"8\" aria-label=\"Children\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more child\">+</button><i>children</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer elder\">−</button><input type=\"number\" name=\"occupant_elders\" value=\"1\" min=\"0\" max=\"6\" aria-label=\"Elders\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more elder\">+</button><i>elders</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Access</span>\n          <div class=\"row__v\">\n            <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"elderly_access\" value=\"1\" checked><span>Step-free for elders</span></label>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-money\">\n        <h2 class=\"spec__h\" id=\"g-money\">Budget</h2>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-budget\">Ceiling</label>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num num--wide\"><i class=\"num__pre\">₹</i><input type=\"number\" name=\"budget\" id=\"inp-budget\" value=\"6500000\" min=\"500000\" step=\"50000\"><i id=\"budget-words\">65 lakh</i></label>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-finish-tier\">Finish</label>\n          <div class=\"row__v\">\n            <select name=\"finish_tier\" id=\"inp-finish-tier\">\n              <option value=\"standard\">Standard</option>\n              <option value=\"premium\" selected>Premium</option>\n              <option value=\"luxury\">Luxury, bespoke</option>\n            </select>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-vastu\">\n        <h2 class=\"spec__h\" id=\"g-vastu\">Vastu</h2>\n        <div class=\"row row--stack\">\n          <div class=\"seg\" id=\"stance-scale\" role=\"radiogroup\" aria-labelledby=\"g-vastu\">\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"0\"><span>Modern</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"1\"><span>Advisory</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"2\" checked><span>Balanced</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"3\"><span>Strict</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"4\"><span>Orthodox</span></label>\n          </div>\n          <p class=\"row__note\" id=\"stance-note\">Classical rules and modern building science carry equal weight.</p>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-style\">\n        <h2 class=\"spec__h\" id=\"g-style\">Style</h2>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-styles\">Language</label>\n          <div class=\"row__v\">\n            <select name=\"styles\" id=\"inp-styles\">\n              <option value=\"tropical_modern\" selected>Tropical modern</option>\n              <option value=\"contemporary\">Contemporary minimal</option>\n              <option value=\"biophilic\">Biophilic</option>\n              <option value=\"kerala_vernacular\">Kerala vernacular</option>\n              <option value=\"chettinad\">Chettinad heritage</option>\n              <option value=\"modern_minimal\">Modern minimalist</option>\n              <option value=\"japandi\">Japandi</option>\n              <option value=\"industrial\">Industrial loft</option>\n              <option value=\"scandinavian\">Scandinavian</option>\n            </select>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"go\">\n        <p class=\"go__sum\" id=\"sum-line\">216 m² plot · 3 bedrooms · ₹65 lakh · Vastu balanced</p>\n        <button type=\"submit\" class=\"btn btn--cream btn--go\" id=\"convene\">\n          <span class=\"convene__title-text\">Convene the studio</span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg>\n        </button>\n        <p class=\"go__fine\" id=\"convene-sub\">13 specialists · 3 schemes · costs nothing to run</p>\n      </div>\n    </form>\n\n    <!-- Review a plan you already have -->\n    <form id=\"upload\" class=\"spec\" hidden novalidate>\n      <section class=\"spec__group\" aria-labelledby=\"g-file\">\n        <h2 class=\"spec__h\" id=\"g-file\">The drawing</h2>\n        <label class=\"dropzone\" id=\"dropzone\" for=\"inp-file\">\n          <input type=\"file\" id=\"inp-file\" name=\"file\" accept=\".dxf,.svg,.png,.jpg,.jpeg,.webp,.json,image/*,application/json\">\n          <svg class=\"dropzone__icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path d=\"M6 6h36v36H6zM6 24h18M24 6v18M24 24h18M24 24v18\"/></svg>\n          <span class=\"dropzone__title\" id=\"drop-title\">Drop a plan here, or choose a file</span>\n          <span class=\"dropzone__sub\" id=\"drop-sub\">DXF and SVG are read exactly, room by room. A photo or scan is read by a vision model, and every room it finds is listed for you to check.</span>\n          <span class=\"dropzone__file\" id=\"drop-file\" hidden></span>\n        </label>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-ctx\">\n        <h2 class=\"spec__h\" id=\"g-ctx\">Context</h2>\n        <div class=\"row\">\n          <span class=\"row__k\">Plot</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num\"><input type=\"number\" id=\"up-plot-width\" name=\"plot_width\" placeholder=\"auto\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot width in metres\"><i>m wide</i></label>\n            <span class=\"times\" aria-hidden=\"true\">×</span>\n            <label class=\"num\"><input type=\"number\" id=\"up-plot-depth\" name=\"plot_depth\" placeholder=\"auto\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot depth in metres\"><i>m deep</i></label>\n          </div>\n        </div>\n        <p class=\"row__note\">Leave the plot blank for a DXF with real units. For an image or a unitless SVG, the plot size sets the scale.</p>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-road\">Road on the</label>\n          <div class=\"row__v\">\n            <select name=\"road_direction\" id=\"up-road\">\n              <option value=\"N\">North</option><option value=\"NE\">North-east</option>\n              <option value=\"E\">East</option><option value=\"SE\">South-east</option>\n              <option value=\"S\">South</option><option value=\"SW\">South-west</option>\n              <option value=\"W\">West</option><option value=\"NW\">North-west</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-budget\">Budget</label>\n          <div class=\"row__v\"><label class=\"num num--wide\"><i class=\"num__pre\">₹</i><input type=\"number\" id=\"up-budget\" name=\"budget\" placeholder=\"optional\" min=\"0\" step=\"50000\"></label></div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-vastu\">Vastu</label>\n          <div class=\"row__v\">\n            <select name=\"vastu\" id=\"up-vastu\">\n              <option value=\"ignore\">Modern</option>\n              <option value=\"advisory\">Advisory</option>\n              <option value=\"balanced\" selected>Balanced</option>\n              <option value=\"strict\">Strict</option>\n              <option value=\"orthodox\">Orthodox</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-name\">Name</label>\n          <div class=\"row__v\"><input type=\"text\" id=\"up-name\" name=\"name\" maxlength=\"80\" placeholder=\"from the file name\" class=\"text\"></div>\n        </div>\n      </section>\n\n      <div class=\"import-report\" id=\"import-report\" hidden></div>\n\n      <div class=\"go\">\n        <p class=\"go__sum\">Reads the rooms, adds doors and windows where none are drawn, then runs the whole committee on it.</p>\n        <button type=\"submit\" class=\"btn btn--cream btn--go\" id=\"review-btn\">\n          <span>Review this plan</span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg>\n        </button>\n      </div>\n    </form>\n  </div>\n</section>\n\n<!-- ═══ RUN ═══ -->\n<section class=\"running\" id=\"running\" aria-label=\"The studio at work\">\n  <div class=\"atelier\" id=\"atelier\"></div>\n</section>\n\n<!-- ═══ REVIEW ═══ -->\n<section class=\"review\" id=\"review\" aria-label=\"The chosen scheme\">\n\n  <div class=\"stage\" id=\"stage\">\n    <div class=\"subnav\" id=\"subnav\" role=\"tablist\" hidden></div>\n\n    <div class=\"pane\" data-view=\"drawings\">\n      <div class=\"pane__bar\">\n        <div class=\"sheet-groups\" id=\"sheet-groups\" role=\"tablist\" aria-label=\"Drawing sets\"></div>\n        <div class=\"sheet-tabs\" id=\"sheet-tabs\" role=\"tablist\" aria-label=\"Sheets\"></div>\n        <div class=\"pane__tools\">\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"zoom\">Actual size</button>\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-svg\">SVG</button>\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-dxf\" title=\"Editable CAD: AutoCAD, BricsCAD, LibreCAD or QCAD\">DXF</button>\n        </div>\n      </div>\n      <div class=\"plate\" id=\"plate\"></div>\n      <p class=\"plate__caption\" id=\"plate-caption\"></p>\n    </div>\n\n    <div class=\"pane\" data-view=\"mandala\" hidden>\n      <div class=\"mandala-review\">\n        <div class=\"mandala-shell\">\n          <svg class=\"mandala\" id=\"review-mandala\" viewBox=\"0 0 900 900\" aria-hidden=\"true\"></svg>\n          <span class=\"rose-l rose-l--n\">N</span><span class=\"rose-l rose-l--e\">E</span>\n          <span class=\"rose-l rose-l--s\">S</span><span class=\"rose-l rose-l--w\">W</span>\n        </div>\n        <div class=\"mandala-side\">\n          <h2 class=\"pane-h\">The scheme on the mandala</h2>\n          <p class=\"lede\">Each room lights the padas it occupies. The centre nine are scored on their own, because the engine requires them kept open.</p>\n          <p class=\"brahma\" id=\"brahma-note\"></p>\n          <div id=\"quarter-legend\" class=\"legend\"></div>\n          <div id=\"room-sectors\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"pane\" data-view=\"vastu\" hidden></div>\n    <div class=\"pane\" data-view=\"cost\" hidden></div>\n    <div class=\"pane\" data-view=\"interior\" hidden></div>\n    <div class=\"pane\" data-view=\"model\" hidden></div>\n    <div class=\"pane\" data-view=\"findings\" hidden></div>\n    <div class=\"pane\" data-view=\"negotiation\" hidden></div>\n    <div class=\"pane\" data-view=\"audit\" hidden></div>\n  </div>\n\n  <aside class=\"side\" aria-label=\"Verdict\">\n    <div class=\"side__verdict\">\n      <p class=\"side__name\" id=\"pick-name\">Selected scheme</p>\n      <p class=\"side__score\"><b id=\"v-score\">—</b><small id=\"v-agree\"></small></p>\n      <p class=\"pick__why\" id=\"pick-why\"></p>\n      <button type=\"button\" class=\"link\" id=\"see-why\">Why this scheme</button>\n    </div>\n    <dl class=\"stats\">\n      <div><dt>Estimate</dt><dd id=\"v-cost\">—</dd><small id=\"v-cost-note\"></small></div>\n      <div><dt>Built area</dt><dd id=\"v-area\">—</dd><small id=\"v-far\"></small></div>\n      <div><dt>Vastu</dt><dd id=\"v-vastu\">—</dd><small id=\"v-vastu-note\"></small></div>\n      <div><dt>Findings</dt><dd id=\"v-find\">—</dd><small id=\"v-find-note\"></small></div>\n    </dl>\n    <h2 class=\"side__h\">Committee</h2>\n    <ol class=\"critics\" id=\"critics\"></ol>\n    <details class=\"side__brief\">\n      <summary>The brief</summary>\n      <dl class=\"kv\" id=\"brief-recap\"></dl>\n    </details>\n  </aside>\n</section>\n\n</main>\n\n<!-- ═══ OVERLAYS ═══ -->\n<div class=\"sheetover\" id=\"why\" hidden>\n  <div class=\"sheetover__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"why-h\">\n    <div class=\"sheetover__bar\">\n      <h2 id=\"why-h\">Why this scheme</h2>\n      <button type=\"button\" class=\"x\" id=\"why-close\" aria-label=\"Close\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n      </button>\n    </div>\n    <div class=\"sheetover__body\" id=\"why-body\"></div>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\" role=\"status\" hidden></div>\n\n<script src=\"studio.js?v=r1\" type=\"module\"></script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":866,"cache_read_input_tokens":456147,"output_tokens":8517,"output_tokens_details":{"thinking_tokens":39},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":866,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8517,"cache_read_input_tokens":456147,"cache_creation_input_tokens":866,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":866},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_0114bHgFCuSRoZwJAC83J3FR":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\index.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Atri Arch Studio</title>\n<meta name=\"description\" content=\"Brief a house, watch a studio of architects and thirteen specialists design it, and defend the scheme they choose.\">\n<meta name=\"theme-color\" content=\"#0b0a09\">\n<link rel=\"preload\" href=\"fonts/Archivo-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<link rel=\"preload\" href=\"fonts/Geist-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<script type=\"importmap\">{\"imports\":{\"three\":\"./vendor/three/three.module.min.js\",\"three/addons/\":\"./vendor/three/addons/\"}}</script>\n<link rel=\"stylesheet\" href=\"rabbit.css?v=r1\">\n</head>\n<body data-phase=\"compose\" data-mode=\"brief\">\n\n<div class=\"grain\" aria-hidden=\"true\"></div>\n<a class=\"skip\" href=\"#main\">Skip to the content</a>\n\n<!-- ═══ HEADER ═══ -->\n<header class=\"bar\">\n  <button type=\"button\" class=\"wordmark\" id=\"home\" aria-label=\"Atri Arch, back to the brief\">\n    <img src=\"logo_emblem.png\" alt=\"\" width=\"28\" height=\"28\">\n    <span>Atri Arch</span>\n  </button>\n\n  <div class=\"bar__mid\">\n    <div class=\"schemes\" id=\"schemes\" role=\"tablist\" aria-label=\"Schemes\"></div>\n  </div>\n\n  <nav class=\"views\" id=\"views\" aria-label=\"Views\">\n    <button type=\"button\" class=\"view-tab is-on\" data-view=\"drawings\">Drawings</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"model\">3D</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"vastu\">Vastu</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"cost\">Cost</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"interior\">Interior</button>\n    <button type=\"button\" class=\"view-tab\" data-view=\"report\">Report</button>\n  </nav>\n\n  <div class=\"bar__end\">\n    <p class=\"engine\" aria-live=\"polite\"><i id=\"engine-dot\" data-tone=\"running\"></i><span id=\"engine-note\">Connecting</span></p>\n    <button type=\"button\" class=\"btn btn--line\" id=\"restart\" hidden>New brief</button>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<!-- ═══ BRIEF ═══ -->\n<section class=\"compose\" id=\"compose\" aria-label=\"The brief\">\n\n  <div class=\"compose__title\">\n    <h1 class=\"headline\" id=\"headline\">\n      <span class=\"headline__soft\">A home on</span>\n      <span class=\"headline__hard\" id=\"hl-plot\">12 × 18 m</span>\n      <span class=\"headline__soft\">facing <span id=\"hl-road\">north</span>,</span>\n      <span class=\"headline__hard headline__hard--sm\" id=\"hl-prog\">3 bedrooms, 2 storeys</span>\n    </h1>\n\n    <figure class=\"plotfig\" aria-label=\"The plot, drawn to scale\">\n      <svg id=\"plot-svg\" viewBox=\"0 0 420 340\" role=\"img\" aria-labelledby=\"plot-cap\"></svg>\n      <figcaption id=\"plot-cap\">Plot, setbacks and road, drawn to scale from the brief.</figcaption>\n    </figure>\n  </div>\n\n  <div class=\"compose__sheet\">\n    <div class=\"modes\" id=\"mode-switch\" role=\"tablist\" aria-label=\"How to begin\">\n      <button type=\"button\" class=\"mode-tab\" role=\"tab\" data-mode=\"brief\" aria-selected=\"true\">Design from a brief</button>\n      <button type=\"button\" class=\"mode-tab\" role=\"tab\" data-mode=\"upload\" aria-selected=\"false\">Review a plan I have</button>\n    </div>\n\n    <!-- The brief, as a specification sheet -->\n    <form id=\"brief\" class=\"spec\" novalidate>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-site\">\n        <h2 class=\"spec__h\" id=\"g-site\">Site</h2>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Plot</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num\"><input type=\"number\" id=\"inp-plot-width\" name=\"plot_width\" value=\"12\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot width, east to west, in metres\"><i>m wide</i></label>\n            <span class=\"times\" aria-hidden=\"true\">×</span>\n            <label class=\"num\"><input type=\"number\" id=\"inp-plot-depth\" name=\"plot_depth\" value=\"18\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot depth, north to south, in metres\"><i>m deep</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\" id=\"k-road\">Road on the</span>\n          <div class=\"row__v\">\n            <div class=\"rose\" id=\"direction-grid\" role=\"radiogroup\" aria-labelledby=\"k-road\">\n              <label class=\"dir-radio\" data-val=\"NW\"><input type=\"radio\" name=\"road_direction\" value=\"NW\"><span>NW</span></label>\n              <label class=\"dir-radio\" data-val=\"N\"><input type=\"radio\" name=\"road_direction\" value=\"N\" checked><span>N</span></label>\n              <label class=\"dir-radio\" data-val=\"NE\"><input type=\"radio\" name=\"road_direction\" value=\"NE\"><span>NE</span></label>\n              <label class=\"dir-radio\" data-val=\"W\"><input type=\"radio\" name=\"road_direction\" value=\"W\"><span>W</span></label>\n              <span class=\"rose__c\" aria-hidden=\"true\"></span>\n              <label class=\"dir-radio\" data-val=\"E\"><input type=\"radio\" name=\"road_direction\" value=\"E\"><span>E</span></label>\n              <label class=\"dir-radio\" data-val=\"SW\"><input type=\"radio\" name=\"road_direction\" value=\"SW\"><span>SW</span></label>\n              <label class=\"dir-radio\" data-val=\"S\"><input type=\"radio\" name=\"road_direction\" value=\"S\"><span>S</span></label>\n              <label class=\"dir-radio\" data-val=\"SE\"><input type=\"radio\" name=\"road_direction\" value=\"SE\"><span>SE</span></label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Setbacks</span>\n          <div class=\"row__v row__v--trio\">\n            <label class=\"num\"><input type=\"number\" name=\"setback_front\" value=\"2.5\" step=\"0.5\" min=\"1\" aria-label=\"Front setback in metres\"><i>m front</i></label>\n            <label class=\"num\"><input type=\"number\" name=\"setback_rear\" value=\"1.5\" step=\"0.5\" min=\"1\" aria-label=\"Rear setback in metres\"><i>m rear</i></label>\n            <label class=\"num\"><input type=\"number\" name=\"setback_side\" value=\"1.2\" step=\"0.2\" min=\"1\" aria-label=\"Side setbacks in metres\"><i>m sides</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-levels\">Storeys</label>\n          <div class=\"row__v\">\n            <select name=\"levels\" id=\"inp-levels\">\n              <option value=\"1\">Ground only</option>\n              <option value=\"2\" selected>Ground + 1</option>\n              <option value=\"3\">Ground + 2</option>\n              <option value=\"4\">Stilt + 3</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-locality\">City</label>\n          <div class=\"row__v\"><input type=\"text\" name=\"locality\" id=\"inp-locality\" value=\"Bengaluru, Karnataka\" maxlength=\"120\" class=\"text\"></div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-prog\">\n        <h2 class=\"spec__h\" id=\"g-prog\">Programme</h2>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Rooms</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer bedroom\">−</button><input type=\"number\" name=\"bedrooms\" id=\"inp-bedrooms\" value=\"3\" min=\"1\" max=\"8\" aria-label=\"Bedrooms\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more bedroom\">+</button><i>bedrooms</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer bathroom\">−</button><input type=\"number\" name=\"bathrooms\" id=\"inp-bathrooms\" value=\"3\" min=\"1\" max=\"8\" aria-label=\"Bathrooms\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more bathroom\">+</button><i>bathrooms</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-kitchen\">Kitchen</label>\n          <div class=\"row__v\">\n            <select name=\"kitchen_type\" id=\"inp-kitchen\">\n              <option value=\"open_modular\" selected>Open modular</option>\n              <option value=\"closed\">Closed, traditional</option>\n              <option value=\"wet_dry\">Wet and dry, separate</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Also</span>\n          <div class=\"row__v\">\n            <div class=\"toggles\">\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_pooja\" value=\"1\" checked><span>Pooja room</span></label>\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_dining\" value=\"1\" checked><span>Dining</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_study\" value=\"1\"><span>Study</span></label>\n              <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"amenity_utility\" value=\"1\" checked><span>Utility</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_balcony\" value=\"1\"><span>Balcony</span></label>\n              <label class=\"amenity-chip\"><input type=\"checkbox\" name=\"amenity_parking\" value=\"1\"><span>Parking</span></label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Living here</span>\n          <div class=\"row__v row__v--trio\">\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer adult\">−</button><input type=\"number\" name=\"occupant_adults\" value=\"2\" min=\"1\" max=\"10\" aria-label=\"Adults\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more adult\">+</button><i>adults</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer child\">−</button><input type=\"number\" name=\"occupant_children\" value=\"1\" min=\"0\" max=\"8\" aria-label=\"Children\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more child\">+</button><i>children</i></label>\n            <label class=\"num num--step\"><button type=\"button\" class=\"step\" data-step=\"-1\" aria-label=\"One fewer elder\">−</button><input type=\"number\" name=\"occupant_elders\" value=\"1\" min=\"0\" max=\"6\" aria-label=\"Elders\"><button type=\"button\" class=\"step\" data-step=\"1\" aria-label=\"One more elder\">+</button><i>elders</i></label>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <span class=\"row__k\">Access</span>\n          <div class=\"row__v\">\n            <label class=\"amenity-chip is-checked\"><input type=\"checkbox\" name=\"elderly_access\" value=\"1\" checked><span>Step-free for elders</span></label>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-money\">\n        <h2 class=\"spec__h\" id=\"g-money\">Budget</h2>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-budget\">Ceiling</label>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num num--wide\"><i class=\"num__pre\">₹</i><input type=\"number\" name=\"budget\" id=\"inp-budget\" value=\"6500000\" min=\"500000\" step=\"50000\"><i id=\"budget-words\">65 lakh</i></label>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-finish-tier\">Finish</label>\n          <div class=\"row__v\">\n            <select name=\"finish_tier\" id=\"inp-finish-tier\">\n              <option value=\"standard\">Standard</option>\n              <option value=\"premium\" selected>Premium</option>\n              <option value=\"luxury\">Luxury, bespoke</option>\n            </select>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-vastu\">\n        <h2 class=\"spec__h\" id=\"g-vastu\">Vastu</h2>\n        <div class=\"row row--stack\">\n          <div class=\"seg\" id=\"stance-scale\" role=\"radiogroup\" aria-labelledby=\"g-vastu\">\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"0\"><span>Modern</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"1\"><span>Advisory</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"2\" checked><span>Balanced</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"3\"><span>Strict</span></label>\n            <label><input type=\"radio\" name=\"vastu_slider\" value=\"4\"><span>Orthodox</span></label>\n          </div>\n          <p class=\"row__note\" id=\"stance-note\">Classical rules and modern building science carry equal weight.</p>\n        </div>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-style\">\n        <h2 class=\"spec__h\" id=\"g-style\">Style</h2>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"inp-styles\">Language</label>\n          <div class=\"row__v\">\n            <select name=\"styles\" id=\"inp-styles\">\n              <option value=\"tropical_modern\" selected>Tropical modern</option>\n              <option value=\"contemporary\">Contemporary minimal</option>\n              <option value=\"biophilic\">Biophilic</option>\n              <option value=\"kerala_vernacular\">Kerala vernacular</option>\n              <option value=\"chettinad\">Chettinad heritage</option>\n              <option value=\"modern_minimal\">Modern minimalist</option>\n              <option value=\"japandi\">Japandi</option>\n              <option value=\"industrial\">Industrial loft</option>\n              <option value=\"scandinavian\">Scandinavian</option>\n            </select>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"go\">\n        <p class=\"go__sum\" id=\"sum-line\">216 m² plot · 3 bedrooms · ₹65 lakh · Vastu balanced</p>\n        <button type=\"submit\" class=\"btn btn--cream btn--go\" id=\"convene\">\n          <span class=\"convene__title-text\">Convene the studio</span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg>\n        </button>\n        <p class=\"go__fine\" id=\"convene-sub\">13 specialists · 3 schemes · costs nothing to run</p>\n      </div>\n    </form>\n\n    <!-- Review a plan you already have -->\n    <form id=\"upload\" class=\"spec\" hidden novalidate>\n      <section class=\"spec__group\" aria-labelledby=\"g-file\">\n        <h2 class=\"spec__h\" id=\"g-file\">The drawing</h2>\n        <label class=\"dropzone\" id=\"dropzone\" for=\"inp-file\">\n          <input type=\"file\" id=\"inp-file\" name=\"file\" accept=\".dxf,.svg,.png,.jpg,.jpeg,.webp,.json,image/*,application/json\">\n          <svg class=\"dropzone__icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path d=\"M6 6h36v36H6zM6 24h18M24 6v18M24 24h18M24 24v18\"/></svg>\n          <span class=\"dropzone__title\" id=\"drop-title\">Drop a plan here, or choose a file</span>\n          <span class=\"dropzone__sub\" id=\"drop-sub\">DXF and SVG are read exactly, room by room. A photo or scan is read by a vision model, and every room it finds is listed for you to check.</span>\n          <span class=\"dropzone__file\" id=\"drop-file\" hidden></span>\n        </label>\n      </section>\n\n      <section class=\"spec__group\" aria-labelledby=\"g-ctx\">\n        <h2 class=\"spec__h\" id=\"g-ctx\">Context</h2>\n        <div class=\"row\">\n          <span class=\"row__k\">Plot</span>\n          <div class=\"row__v row__v--pair\">\n            <label class=\"num\"><input type=\"number\" id=\"up-plot-width\" name=\"plot_width\" placeholder=\"auto\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot width in metres\"><i>m wide</i></label>\n            <span class=\"times\" aria-hidden=\"true\">×</span>\n            <label class=\"num\"><input type=\"number\" id=\"up-plot-depth\" name=\"plot_depth\" placeholder=\"auto\" min=\"3\" max=\"200\" step=\"0.5\" aria-label=\"Plot depth in metres\"><i>m deep</i></label>\n          </div>\n        </div>\n        <p class=\"row__note\">Leave the plot blank for a DXF with real units. For an image or a unitless SVG, the plot size sets the scale.</p>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-road\">Road on the</label>\n          <div class=\"row__v\">\n            <select name=\"road_direction\" id=\"up-road\">\n              <option value=\"N\">North</option><option value=\"NE\">North-east</option>\n              <option value=\"E\">East</option><option value=\"SE\">South-east</option>\n              <option value=\"S\">South</option><option value=\"SW\">South-west</option>\n              <option value=\"W\">West</option><option value=\"NW\">North-west</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-budget\">Budget</label>\n          <div class=\"row__v\"><label class=\"num num--wide\"><i class=\"num__pre\">₹</i><input type=\"number\" id=\"up-budget\" name=\"budget\" placeholder=\"optional\" min=\"0\" step=\"50000\"></label></div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-vastu\">Vastu</label>\n          <div class=\"row__v\">\n            <select name=\"vastu\" id=\"up-vastu\">\n              <option value=\"ignore\">Modern</option>\n              <option value=\"advisory\">Advisory</option>\n              <option value=\"balanced\" selected>Balanced</option>\n              <option value=\"strict\">Strict</option>\n              <option value=\"orthodox\">Orthodox</option>\n            </select>\n          </div>\n        </div>\n        <div class=\"row\">\n          <label class=\"row__k\" for=\"up-name\">Name</label>\n          <div class=\"row__v\"><input type=\"text\" id=\"up-name\" name=\"name\" maxlength=\"80\" placeholder=\"from the file name\" class=\"text\"></div>\n        </div>\n      </section>\n\n      <div class=\"import-report\" id=\"import-report\" hidden></div>\n\n      <div class=\"go\">\n        <p class=\"go__sum\">Reads the rooms, adds doors and windows where none are drawn, then runs the whole committee on it.</p>\n        <button type=\"submit\" class=\"btn btn--cream btn--go\" id=\"review-btn\">\n          <span>Review this plan</span>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg>\n        </button>\n      </div>\n    </form>\n  </div>\n</section>\n\n<!-- ═══ RUN ═══ -->\n<section class=\"running\" id=\"running\" aria-label=\"The studio at work\">\n  <div class=\"atelier\" id=\"atelier\"></div>\n</section>\n\n<!-- ═══ REVIEW ═══ -->\n<section class=\"review\" id=\"review\" aria-label=\"The chosen scheme\">\n\n  <div class=\"stage\" id=\"stage\">\n    <div class=\"subnav\" id=\"subnav\" role=\"tablist\" hidden></div>\n\n    <div class=\"pane\" data-view=\"drawings\">\n      <div class=\"pane__bar\">\n        <div class=\"sheet-groups\" id=\"sheet-groups\" role=\"tablist\" aria-label=\"Drawing sets\"></div>\n        <div class=\"sheet-tabs\" id=\"sheet-tabs\" role=\"tablist\" aria-label=\"Sheets\"></div>\n        <div class=\"pane__tools\">\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"zoom\">Actual size</button>\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-svg\">SVG</button>\n          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-dxf\" title=\"Editable CAD: AutoCAD, BricsCAD, LibreCAD or QCAD\">DXF</button>\n        </div>\n      </div>\n      <div class=\"plate\" id=\"plate\"></div>\n      <p class=\"plate__caption\" id=\"plate-caption\"></p>\n    </div>\n\n    <div class=\"pane\" data-view=\"mandala\" hidden>\n      <div class=\"mandala-review\">\n        <div class=\"mandala-shell\">\n          <svg class=\"mandala\" id=\"review-mandala\" viewBox=\"0 0 900 900\" aria-hidden=\"true\"></svg>\n          <span class=\"rose-l rose-l--n\">N</span><span class=\"rose-l rose-l--e\">E</span>\n          <span class=\"rose-l rose-l--s\">S</span><span class=\"rose-l rose-l--w\">W</span>\n        </div>\n        <div class=\"mandala-side\">\n          <h2 class=\"pane-h\">The scheme on the mandala</h2>\n          <p class=\"lede\">Each room lights the padas it occupies. The centre nine are scored on their own, because the engine requires them kept open.</p>\n          <p class=\"brahma\" id=\"brahma-note\"></p>\n          <div id=\"quarter-legend\" class=\"legend\"></div>\n          <div id=\"room-sectors\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"pane\" data-view=\"vastu\" hidden></div>\n    <div class=\"pane\" data-view=\"cost\" hidden></div>\n    <div class=\"pane\" data-view=\"interior\" hidden></div>\n    <div class=\"pane\" data-view=\"model\" hidden></div>\n    <div class=\"pane\" data-view=\"findings\" hidden></div>\n    <div class=\"pane\" data-view=\"negotiation\" hidden></div>\n    <div class=\"pane\" data-view=\"audit\" hidden></div>\n  </div>\n\n  <aside class=\"side\" aria-label=\"Verdict\">\n    <div class=\"side__verdict\">\n      <p class=\"side__name\" id=\"pick-name\">Selected scheme</p>\n      <p class=\"side__score\"><b id=\"v-score\">—</b><small id=\"v-agree\"></small></p>\n      <p class=\"pick__why\" id=\"pick-why\"></p>\n      <button type=\"button\" class=\"link\" id=\"see-why\">Why this scheme</button>\n    </div>\n    <dl class=\"stats\">\n      <div><dt>Estimate</dt><dd id=\"v-cost\">—</dd><small id=\"v-cost-note\"></small></div>\n      <div><dt>Built area</dt><dd id=\"v-area\">—</dd><small id=\"v-far\"></small></div>\n      <div><dt>Vastu</dt><dd id=\"v-vastu\">—</dd><small id=\"v-vastu-note\"></small></div>\n      <div><dt>Findings</dt><dd id=\"v-find\">—</dd><small id=\"v-find-note\"></small></div>\n    </dl>\n    <h2 class=\"side__h\">Committee</h2>\n    <ol class=\"critics\" id=\"critics\"></ol>\n    <details class=\"side__brief\">\n      <summary>The brief</summary>\n      <dl class=\"kv\" id=\"brief-recap\"></dl>\n    </details>\n  </aside>\n</section>\n\n</main>\n\n<!-- ═══ OVERLAYS ═══ -->\n<div class=\"sheetover\" id=\"why\" hidden>\n  <div class=\"sheetover__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"why-h\">\n    <div class=\"sheetover__bar\">\n      <h2 id=\"why-h\">Why this scheme</h2>\n      <button type=\"button\" class=\"x\" id=\"why-close\" aria-label=\"Close\">