{"parentUuid":"e3085fdc-c39a-4085-9b4e-70cd424a67c2","isSidechain":false,"promptId":"cde90b88-60f3-4a8e-aba6-b51e470ae5ea","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016bxArKcJTC1UHcLRzP38pi","type":"tool_result","content":"199\tdef _add_level(\n200\t    model: BuildingModel,\n201\t    plan: FloorPlan,\n202\t    level: Level,\n203\t    base_y: float,\n204\t    include_glazing: bool,\n205\t    include_furniture: bool,\n206\t) -> None:\n207\t    # Floor slab under the whole level.\n208\t    env = level.envelope()\n209\t    if env.area > 0:\n210\t        vertices, faces = _prism(env.to_polygon(), base_y - 0.15, 0.15)\n211\t        model.parts.append(\n212\t            MeshPart(f\"slab_L{level.index}\", vertices, faces, SLAB_COLOUR, \"structure\")\n213\t        )\n214\t\n215\t    for room in level.rooms:\n216\t        _room_floor(model, room, base_y)\n217\t        if include_furniture:\n218\t            _room_furniture(model, room, base_y)\n219\t\n220\t    for wall in level.walls:\n221\t        _add_wall(model, wall, base_y, level.floor_to_floor, include_glazing)\n222\t\n223\t    for stair in level.staircases:\n224\t        _add_stair(model, stair, base_y)\n225\t\n226\t\n227\tdef _room_floor(model: BuildingModel, room: Room, base_y: float) -> None:\n228\t    if room.type is RoomType.SHAFT:\n229\t        return\n230\t    polygon = room.polygon\n231\t    if len(polygon) > 4:\n232\t        # Non-convex imported outline: use its bounding box so the fan\n233\t        # triangulation in `_prism` stays valid rather than producing folds.\n234\t        polygon = room.bbox.to_polygon()\n235\t    vertices, faces = _prism(polygon, base_y, 0.02)\n236\t    colour = ROOM_COLOURS.get(room.type, (210, 205, 198, 255))\n237\t    model.parts.append(\n238\t        MeshPart(f\"floor_{room.id}\", vertices, faces, colour, \"finish\")\n239\t    )\n240\t\n241\t\n242\tdef _add_wall(\n243\t    model: BuildingModel,\n244\t    wall: Wall,\n245\t    base_y: float,\n246\t    floor_to_floor: float,\n247\t    include_glazing: bool,\n248\t) -> None:\n249\t    \"\"\"Build a wall as the set of solid pieces left around its openings.\"\"\"\n250\t    direction = wall.end - wall.start\n251\t    length = direction.length\n252\t    if length < 1e-6:\n253\t        return\n254\t\n255\t    height = min(wall.height, floor_to_floor - 0.15)\n256\t    unit = direction.normalised()\n257\t    angle = math.atan2(-unit.y, unit.x)          # plan Y maps to model -Z\n258\t    midpoint = (wall.start + wall.end) * 0.5\n259\t    thickness = wall.thickness\n260\t    colour = WALL_COLOUR\n261\t\n262\t    openings = sorted(wall.openings, key=lambda o: o.position)\n263\t    if not openings:\n264\t        _emit_wall_piece(model, wall, midpoint, 0.0, length, 0.0, height, thickness, angle, base_y, colour)\n265\t        return\n266\t\n267\t    def piece(u0: float, u1: float, y0: float, y1: float) -> None:\n268\t        if u1 - u0 < 0.01 or y1 - y0 < 0.01:\n269\t            return\n270\t        offset = (u0 + u1) / 2 - length / 2\n271\t        centre = midpoint + unit * offset\n272\t        _emit_wall_piece(\n273\t            model, wall, centre, 0.0, u1 - u0, y0, y1, thickness, angle, base_y, colour\n274\t        )\n275\t\n276\t    cursor = 0.0\n277\t    for opening in openings:\n278\t        centre_u = opening.position * length\n279\t        left = max(0.0, centre_u - opening.width / 2)\n280\t        right = min(length, centre_u + opening.width / 2)\n281\t        if right <= left:\n282\t            continue\n283\t\n284\t        # Full-height wall before the opening.\n285\t        piece(cursor, left, 0.0, height)\n286\t        # Below the sill and above the head.\n287\t        piece(left, right, 0.0, min(opening.sill_height, height))\n288\t        piece(left, right, min(opening.head_height, height), height)\n289\t\n290\t        if include_glazing:\n291\t            _add_opening_panel(model, wall, opening, unit, midpoint, length, angle, base_y, height)\n292\t        cursor = right\n293\t\n294\t    piece(cursor, length, 0.0, height)\n295\t\n296\t\n297\tdef _emit_wall_piece(\n298\t    model: BuildingModel,\n299\t    wall: Wall,\n300\t    centre: Vec2,\n301\t    _unused: float,\n302\t    piece_length: float,\n303\t    y0: float,\n304\t    y1: float,\n305\t    thickness: float,\n306\t    angle: float,\n307\t    base_y: float,\n308\t    colour: tuple[int, int, int, int],\n309\t) -> None:\n310\t    height = y1 - y0\n311\t    vertices, faces = _box(\n312\t        (centre.x, base_y + y0 + height / 2, -centre.y),\n313\t        (piece_length, height, thickness),\n314\t        rotation_y=angle,\n315\t    )\n316\t    model.parts.append(MeshPart(f\"wall_{wall.id}_{len(model.parts)}\", vertices, faces, colour, \"structure\"))\n317\t\n318\t\n319\tdef _add_opening_panel(\n320\t    model: BuildingModel,\n321\t    wall: Wall,\n322\t    opening: Opening,\n323\t    unit: Vec2,\n324\t    midpoint: Vec2,\n325\t    length: float,\n326\t    angle: float,\n327\t    base_y: float,\n328\t    wall_height: float,\n329\t) -> None:\n330\t    \"\"\"A thin panel filling the aperture: glass for windows, a leaf for doors.\"\"\"\n331\t    centre_u = opening.position * length\n332\t    centre = midpoint + unit * (centre_u - length / 2)\n333\t    top = min(opening.head_height, wall_height)\n334\t    panel_height = max(0.05, top - opening.sill_height)\n335\t    if panel_height <= 0.05:\n336\t        return\n337\t\n338\t    is_glass = opening.kind.is_glazed\n339\t    colour = GLASS_COLOUR if is_glass else DOOR_COLOUR\n340\t    vertices, faces = _box(\n341\t        (centre.x, base_y + opening.sill_height + panel_height / 2, -centre.y),\n342\t        (opening.width, panel_height, 0.04),\n343\t        rotation_y=angle,\n344\t    )\n345\t    model.parts.append(\n346\t        MeshPart(\n347\t            f\"{'glazing' if is_glass else 'door'}_{opening.id}\",\n348\t            vertices, faces, colour, \"glazing\" if is_glass else \"joinery\",\n349\t        )\n350\t    )\n351\t\n352\t\n353\tdef _add_parapet(model: BuildingModel, env: BoundingBox, base_y: float, height: float) -> None:\n354\t    thickness = 0.115\n355\t    edges = [\n356\t        ((env.min_x, env.min_y), (env.max_x, env.min_y)),\n357\t        ((env.max_x, env.min_y), (env.max_x, env.max_y)),\n358\t        ((env.max_x, env.max_y), (env.min_x, env.max_y)),\n359\t        ((env.min_x, env.max_y), (env.min_x, env.min_y)),\n360\t    ]\n361\t    for index, ((x0, y0), (x1, y1)) in enumerate(edges):\n362\t        start, end = Vec2(x0, y0), Vec2(x1, y1)\n363\t        direction = end - start\n364\t        length = direction.length\n365\t        if length < 1e-6:\n366\t            continue\n367\t        unit = direction.normalised()\n368\t        angle = math.atan2(-unit.y, unit.x)\n369\t        centre = (start + end) * 0.5\n370\t        vertices, faces = _box(\n371\t            (centre.x, base_y + height / 2, -centre.y),\n372\t            (length, height, thickness),\n373\t            rotation_y=angle,\n374\t        )\n375\t        model.parts.append(\n376\t            MeshPart(f\"parapet_{index}\", vertices, faces, WALL_COLOUR, \"structure\")\n377\t        )\n378\t\n379\t\n380\tdef _add_stair(model: BuildingModel, stair, base_y: float) -> None:\n381\t    \"\"\"Individual treads, so the stair reads as a stair in the walkthrough.\"\"\"\n382\t    from aip.domain.geometry import bounding_box\n383\t\n384\t    box = bounding_box(stair.polygon)\n385\t    if box.width < 0.4 or box.height < 0.4:\n386\t        return\n387\t    horizontal = box.width >= box.height\n388\t    steps = max(1, min(stair.step_count, 24))\n389\t    run = (box.width if horizontal else box.height) / steps\n390\t    width = stair.width if stair.width > 0 else (box.height if horizontal else box.width)\n391\t\n392\t    for i in range(steps):\n393\t        y = base_y + (i + 1) * stair.riser\n394\t        if horizontal:\n395\t            cx = box.min_x + run * (i + 0.5)\n396\t            cz = box.centre.y\n397\t            size = (run, 0.06, width)\n398\t        else:\n399\t            cx = box.centre.x\n400\t            cz = box.min_y + run * (i + 0.5)\n401\t            size = (width, 0.06, run)\n402\t        vertices, faces = _box((cx, y, -cz), size)\n403\t        model.parts.append(\n404\t            MeshPart(f\"tread_{stair.id}_{i}\", vertices, faces, SLAB_COLOUR, \"structure\")\n405\t        )\n406\t\n407\t\n408\tdef _room_furniture(model: BuildingModel, room: Room, base_y: float) -> None:\n409\t    \"\"\"Blocky indicative furniture, so an empty walkthrough reads as a home.\"\"\"\n410\t    box = room.bbox\n411\t    if box.width < 1.6 or box.height < 1.6:\n412\t        return\n413\t    centre = room.centre\n414\t    colour = (150, 130, 110, 255)\n415\t\n416\t    def block(cx: float, cy: float, w: float, d: float, h: float) -> None:\n417\t        vertices, faces = _box((cx, base_y + h / 2, -cy), (w, h, d))\n418\t        model.parts.append(\n419\t            MeshPart(f\"furn_{room.id}_{len(model.parts)}\", vertices, faces, colour, \"furniture\")\n420\t        )\n421\t\n422\t    if room.type in {RoomType.MASTER_BEDROOM, RoomType.BEDROOM,\n423\t                     RoomType.GUEST_BEDROOM, RoomType.CHILDREN_BEDROOM}:\n424\t        block(centre.x, centre.y, min(1.8, box.width - 0.8), min(2.0, box.height - 0.8), 0.5)\n425\t    elif room.type in {RoomType.LIVING, RoomType.DRAWING, RoomType.FAMILY}:\n426\t        block(centre.x, centre.y - box.height * 0.18, min(2.2, box.width - 1.0), 0.85, 0.42)\n427\t        block(centre.x, centre.y + box.height * 0.1, min(1.1, box.width - 1.4), 0.55, 0.4)\n428\t    elif room.type is RoomType.DINING:\n429\t        block(centre.x, centre.y, min(1.5, box.width - 0.9), min(0.95, box.height - 0.9), 0.75)\n430\t    elif room.type is RoomType.KITCHEN:\n431\t        if box.width >= box.height:\n432\t            block(centre.x, box.min_y + 0.35, box.width - 0.4, 0.6, 0.9)\n433\t        else:\n434\t            block(box.min_x + 0.35, centre.y, 0.6, box.height - 0.4, 0.9)\n435\t\n436\t\n437\t# ---------------------------------------------------------------------------\n438\t# Export\n439\t# ---------------------------------------------------------------------------\n440\t\n441\t\n442\tdef export_glb(plan: FloorPlan, **options: Any) -> bytes:\n443\t    \"\"\"Export the plan as binary glTF.\n444\t\n445\t    GLB is the right target: a single self-contained binary that browsers,\n446\t    `<model-viewer>`, Android Scene Viewer and every WebXR runtime load natively,\n447\t    with no conversion service and no licence.\n448\t    \"\"\""}]},"uuid":"1d2508e4-9ddd-4e6d-a01c-5f84861f8b5a","timestamp":"2026-10-10T14:35:06.730Z","toolUseResult":{"type":"text","file":{"filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\aip\\engines\\experience\\model3d.py","content":"","numLines":250,"startLine":199,"totalLines":554}},"sourceToolAssistantUUID":"e3085fdc-c39a-4085-9b4e-70cd424a67c2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
