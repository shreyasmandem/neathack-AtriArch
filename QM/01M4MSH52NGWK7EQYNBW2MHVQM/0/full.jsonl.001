    <option value=\"strict\">Strict</option>","+              <option value=\"orthodox\">Orthodox</option>","+            </select>","+          </div>","         </div>","-        <div class=\"hud-item\" title=\"Target Budget Ceiling\">","-          <span class=\"hud-label\">Target Budget</span>","-          <span class=\"hud-val\" id=\"hud-budget\">₹65.00 L · Premium</span>","+        <div class=\"row\">","+          <label class=\"row__k\" for=\"up-name\">Name</label>","+          <div class=\"row__v\"><input type=\"text\" id=\"up-name\" name=\"name\" maxlength=\"80\" placeholder=\"from the file name\" class=\"text\"></div>","         </div>","-      </div>","+      </section>"," ","-      <!-- ── ACTION CTA (Sleek, A Lil Less Designed) ── -->","-      <div class=\"studio-cta-wrap\">","-        <button type=\"submit\" class=\"convene convene--studio convene--refined\" id=\"convene\">","-          <div class=\"convene__content\">","-            <div class=\"convene__body\">","-              <div class=\"convene__title-row\">","-                <span class=\"convene__spark\">✦</span>","-                <span class=\"convene__title-text\">Generate Architectural Schemes</span>","-              </div>","-              <span class=\"convene__sub\" id=\"convene-sub\">13 critics · 3 schemes · ₹0 to run</span>","-            </div>","+      <div class=\"import-report\" id=\"import-report\" hidden></div>"," ","-            <!-- Sleek Concentric Action Portal -->","-            <div class=\"convene__action-portal\" aria-hidden=\"true\">","-              <svg class=\"convene__arrow-svg\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">","-                <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>","-                <polyline points=\"12 5 19 12 12 19\"></polyline>","-              </svg>","-            </div>","-          </div>","+      <div class=\"go\">","+        <p class=\"go__sum\">Reads the rooms, adds doors and windows where none are drawn, then runs the whole committee on it.</p>","+        <button type=\"submit\" class=\"btn btn--cream btn--go\" id=\"review-btn\">","+          <span>Review this plan</span>","+          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg>","         </button>","-","-        <!-- Hidden slot for JS critic telemetry compatibility -->","-        <span id=\"convene-critics-status\" style=\"display:none;\" aria-hidden=\"true\"></span>","-","-        <!-- Engine Status Capsule -->","-        <div class=\"engine-status-capsule\" id=\"engine-status-capsule\">","-          <span class=\"engine-dot\" id=\"engine-dot\"></span>","-          <p class=\"engine-note\" id=\"engine-note\">Connecting to architectural engine…</p>","-        </div>","       </div>","-","     </form>","   </div>"," </section>"," ","-<!-- ══════════════════════ RUNNING: THE ATELIER ══════════════════════ -->","-<section class=\"running\" id=\"running\" aria-label=\"Your studio at work\">","+<!-- ═══ RUN ═══ -->","+<section class=\"running\" id=\"running\" aria-label=\"The studio at work\">","   <div class=\"atelier\" id=\"atelier\"></div>"," </section>"," ","-<!-- ══════════════════════ REVIEW ══════════════════════ -->","-<main class=\"review\" id=\"review\">","+<!-- ═══ REVIEW ═══ -->","+<section class=\"review\" id=\"review\" aria-label=\"The chosen scheme\">"," ","-  <section class=\"stage\" id=\"stage\">","+  <div class=\"stage\" id=\"stage\">","     <div class=\"subnav\" id=\"subnav\" role=\"tablist\" hidden></div>","+","     <div class=\"pane\" data-view=\"drawings\">","       <div class=\"pane__bar\">","         <div class=\"sheet-groups\" id=\"sheet-groups\" role=\"tablist\" aria-label=\"Drawing sets\"></div>","-        <div class=\"sheet-tabs\" id=\"sheet-tabs\" role=\"tablist\" aria-label=\"Drawings\"></div>","+        <div class=\"sheet-tabs\" id=\"sheet-tabs\" role=\"tablist\" aria-label=\"Sheets\"></div>","         <div class=\"pane__tools\">","-          <button type=\"button\" class=\"ghost-btn\" id=\"zoom\">Actual size</button>","-          <button type=\"button\" class=\"ghost-btn\" id=\"dl-svg\">SVG</button>","-          <button type=\"button\" class=\"ghost-btn\" id=\"dl-dxf\" title=\"Editable CAD, opens in AutoCAD, BricsCAD, LibreCAD or QCAD\">DXF</button>","+          <button type=\"button\" class=\"btn btn--quiet\" id=\"zoom\">Actual size</button>","+          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-svg\">SVG</button>","+          <button type=\"button\" class=\"btn btn--quiet\" id=\"dl-dxf\" title=\"Editable CAD: AutoCAD, BricsCAD, LibreCAD or QCAD\">DXF</button>","         </div>","       </div>","       <div class=\"plate\" id=\"plate\"></div>"]},{"oldStart":754,"oldLines":18,"newStart":339,"newLines":15,"lines":["     </div>"," ","     <div class=\"pane\" data-view=\"mandala\" hidden>","-      <div class=\"pane__intro\">","-        <h2>The scheme on the mandala</h2>","-        <p>Each room lights the padas it occupies, in the pigment of its quarter.","-           The centre nine are scored separately, because the engine requires them unbuilt.</p>","-      </div>","       <div class=\"mandala-review\">","-        <div class=\"mandala-shell mandala-shell--sm\">","+        <div class=\"mandala-shell\">","           <svg class=\"mandala\" id=\"review-mandala\" viewBox=\"0 0 900 900\" aria-hidden=\"true\"></svg>","-          <span class=\"rose rose--n\">N</span><span class=\"rose rose--e\">E</span>","-          <span class=\"rose rose--s\">S</span><span class=\"rose rose--w\">W</span>","+          <span class=\"rose-l rose-l--n\">N</span><span class=\"rose-l rose-l--e\">E</span>","+          <span class=\"rose-l rose-l--s\">S</span><span class=\"rose-l rose-l--w\">W</span>","         </div>","         <div class=\"mandala-side\">","+          <h2 class=\"pane-h\">The scheme on the mandala</h2>","+          <p class=\"lede\">Each room lights the padas it occupies. The centre nine are scored on their own, because the engine requires them kept open.</p>","           <p class=\"brahma\" id=\"brahma-note\"></p>","           <div id=\"quarter-legend\" class=\"legend\"></div>","           <div id=\"room-sectors\"></div>"]},{"oldStart":780,"oldLines":14,"newStart":362,"newLines":14,"lines":["     <div class=\"pane\" data-view=\"findings\" hidden></div>","     <div class=\"pane\" data-view=\"negotiation\" hidden></div>","     <div class=\"pane\" data-view=\"audit\" hidden></div>","-  </section>","+  </div>"," ","   <aside class=\"side\" aria-label=\"Verdict\">","     <div class=\"side__verdict\">","-      <p class=\"side__eyebrow\"><span id=\"pick-name\">Selected scheme</span></p>","+      <p class=\"side__name\" id=\"pick-name\">Selected scheme</p>","       <p class=\"side__score\"><b id=\"v-score\">—</b><small id=\"v-agree\"></small></p>","       <p class=\"pick__why\" id=\"pick-why\"></p>","-      <button type=\"button\" class=\"link-btn\" id=\"see-why\">Why this scheme</button>","+      <button type=\"button\" class=\"link\" id=\"see-why\">Why this scheme</button>","     </div>","     <dl class=\"stats\">","       <div><dt>Estimate</dt><dd id=\"v-cost\">—</dd><small id=\"v-cost-note\"></small></div>"]},{"oldStart":795,"oldLines":21,"newStart":377,"newLines":25,"lines":["       <div><dt>Vastu</dt><dd id=\"v-vastu\">—</dd><small id=\"v-vastu-note\"></small></div>","       <div><dt>Findings</dt><dd id=\"v-find\">—</dd><small id=\"v-find-note\"></small></div>","     </dl>","-    <h2 class=\"side__head\">Committee</h2>","+    <h2 class=\"side__h\">Committee</h2>","     <ol class=\"critics\" id=\"critics\"></ol>","     <details class=\"side__brief\">","       <summary>The brief</summary>","       <dl class=\"kv\" id=\"brief-recap\"></dl>","     </details>","   </aside>","+</section>","+"," </main>"," ","-<!-- ══════════════════════ OVERLAYS ══════════════════════ -->","+