=\"at-pills\" role=\"tablist\" aria-label=\"Schemes\"></div>\n          </div>\n          <p class=\"at-overall\"><span>Overall</span><b id=\"at-overall\">—</b></p>\n          <p class=\"at-voice\" id=\"at-voice\" aria-live=\"polite\"></p>\n          <ol class=\"at-scores\" id=\"at-scores\"></ol>\n        </aside>\n      </div>\n      <div class=\"at-track\" aria-hidden=\"true\"><i id=\"at-bar\"></i></div>`;''' + s[b:]\n\nrep('''    this.$(\"at-eyebrow\").textContent = upload ? \"Review\" : \"Studio\";\n''', '')\nrep('''    this.$(\"at-title\").textContent = upload ? \"Reviewing your drawing\" : \"The team is at work\";''',\n    '''    this.$(\"at-title\").textContent = upload ? \"Reviewing your drawing\" : \"The studio is at work\";''')\nrep('''    this.$(\"at-step\").textContent = \"Starting\";''', '''    this.$(\"at-step\").textContent = \"Starting\";\n    this.$(\"at-index\").textContent = upload ? \"Reading the drawing\" : \"Setting out\";''')\n# Stage word: rises into place when it changes, like a chapter title.\nrep('''    this.stage3d?.pace(b.ceil);\n    this.$(\"at-step\").textContent = st.label;''', '''    this.stage3d?.pace(b.ceil);\n    this.$(\"at-index\").textContent = `Stage ${st.i + 1} of ${STAGES.length}`;\n    this._chapter(st.label);''')\nrep('''  _say(text) {''', '''  _chapter(word) {\n    const w = this.$(\"at-step\");\n    if (w.textContent === word) return;\n    w.textContent = word;\n    if (!reduced()) w.animate([{ transform: \"translateY(105%)\" }, { transform: \"none\" }], { duration: 620, easing: \"cubic-bezier(.16,1,.3,1)\" });\n  }\n\n  _say(text) {''')\nrep('''    this.$(\"at-step\").textContent = this.upload ? \"Reviewed\" : `Scheme ${this.letter[cand] || \"A\"} selected`;''',\n    '''    this.$(\"at-index\").textContent = \"Decided\";\n    this._chapter(this.upload ? \"Reviewed\" : `Scheme ${this.letter[cand] || \"A\"}`);''')\nrep('''    this.$(\"at-step\").textContent = \"Stopped\";''', '''    this._chapter(\"Stopped\");''')\nrep(''