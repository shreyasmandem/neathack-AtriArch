c16, 1.25));","-    const sun = (this.sun = new THREE.DirectionalLight(0xfff1dc, 2.1));","-    sun.castShadow = true;","-    sun.shadow.mapSize.set(2048, 2048);","-    sun.shadow.bias = -0.0005;","-    scene.add(sun, sun.target);","-    const fill = new THREE.DirectionalLight(0xbcd0ff, 0.45);","-    fill.position.set(-1, 0.6, -0.8);","-    scene.add(fill);","-","-    this.camera = new THREE.PerspectiveCamera(32, 1, 0.1, 500);","-    const c = (this.controls = new OrbitControls(this.camera, r.domElement));","-    c.enableDamping = true;","-    c.dampingFactor = 0.08;","-    c.maxPolarAngle = Math.PI * 0.49;","-    c.autoRotate = !window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;","-    c.autoRotateSpeed = 0.5;","-    c.addEventListener(\"start\", () => { c.autoRotate = false; });","-","-    this.ro = new ResizeObserver(() => this.resize());","-    this.ro.observe(host);","-    this.resize();","-    this._tick = this._tick.bind(this);","-    this.raf = requestAnimationFrame(this._tick);","-  }","-","-  resize() {","-    const w = this.host.clientWidth, h = this.host.clientHeight;","-    if (!w || !h) return;","-    this.renderer.setSize(w, h, false);","-    this.camera.aspect = w / h;","-    this.camera.updateProjectionMatrix();","-  }","-","-  async load(url) {","-    const gltf = await new GLTFLoader().loadAsync(url);","-    if (this.model) this.scene.remove(this.model);","-    const m = (this.model = gltf.scene);","-    let tris = 0;","-    m.traverse((o) => {","-      if (!o.isMesh) return;","-      o.castShadow = true;","-      o.receiveShadow = true;","-      const g = o.geometry;","-      tris += (g.index ? g.index.count : g.attributes.position.count) / 3;","-      for (const mat of [].concat(o.material)) {","-        if (mat && \"roughness\" in mat) mat.roughness = Math.max(mat.roughness ?? 0.8, 0.6);","-      }","-    });","-    this.scene.add(m);","-","-    // Frame it: centre on the footprint, sit it on the table, and light it","-    // from over the viewer's shoulder so the faces you see first read.","-    const box = new THREE.Box3().setFromObject(m);","-    const size = box.getSize(new THREE.Vector3());","-    const centre = box.getCenter(new THREE.Vector3());","-    m.position.sub(new THREE.Vector3(centre.x, box.min.y, centre.z));","-    const span = Math.max(size.x, size.z, size.y * 1.5);","-","-    const ground = new THREE.Mesh(new THREE.CircleGeometry(span * 1.6, 64),","-      new THREE.MeshStandardMaterial({ color: 0x141312, roughness: 1 }));","-    ground.rotation.x = -Math.PI / 2;","-    ground.position.y = -0.002;","-    ground.receiveShadow = true;","-    if (this.ground) this.scene.remove(this.ground);","-    this.ground = ground;","-    this.scene.add(ground);","-","-    const sc = this.sun.shadow.camera;","-    sc.left = -span; sc.right = span; sc.top = span; sc.bottom = -span; sc.far = span * 6;","-    sc.updateProjectionMatrix();","-    this.sun.position.set(span * 0.35, span * 1.7, span * 1.25);","-","-    const dist = span / (2 * Math.tan((this.camera.fov * Math.PI) / 360)) * 1.35;","-    this.camera.position.set(dist * 0.62, dist * 0.55, dist * 0.78);","-    this.controls.target.set(0, size.y * 0.3, 0);","-    this.controls.minDistance = span * 0.4;","-    this.controls.maxDistance = span * 4;","-    this.controls.update();","-    return { triangles: Math.round(tris), width: size.x, depth: size.z, height: size.y };","-  }","-","-  _tick() {","-    this.raf = requestAnimationFrame(this._tick);","-    this.controls.update();","-    this.renderer.render(this.scene, this.camera);","-  }","-","-  dispose() {","-    cancelAnimationFrame(this.raf);","-    this.ro.disconnect();","-    this.controls.dispose();","-    this.renderer.dispose();","-    this.renderer.domElement.remove();","-  }","-}","+/* ═══════════════════════════════════════════════════════════════════════\r","+   Viewer3D: the scheme's glTF model, in the page.\r","+\r","+   The same .glb the studio exports, loaded as is and lit like a massing\r","+   model on a dark table. Drag to orbit, scroll to zoom. It opens at a\r","+   three-quarter view from the road side and turns slowly until touched.\r","+   ═══════════════════════════════════════════════════════════════════════ */\r","+\r","+import * as THREE from \"three\";\r","+import { GLTFLoader } from \"three/addons/loaders/GLTFLoader.js\";\r","+import { OrbitControls } from \"three/addons/controls/OrbitControls.js\";\r","+\r","+// A neutral \"photo studio\" environment, generated in code so nothing extra\r","+// has to be downloaded: a warm ceiling glow, a cool sky side, a dark floor.\r","+function studioEnvironment(renderer) {\r","+  const env = new THREE.Scene();\r","+  const room = new THREE.Mesh(new THREE.BoxGeometry(20, 12, 20),\r","+    new THREE.MeshBasicMaterial({ color: 0x8a8580, side: THREE.BackSide }));\r","+  env.add(room);\r","+  const panel = (color, intensity, w, h, pos, rot) => {\r","+    const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h),\r","+      new THREE.MeshBasicMaterial({ color: new THREE.Color(color).multiplyScalar(intensity), side: THREE.DoubleSide }));\r","+    m.position.set(...pos);\r","+    m.rotation.set(...rot);\r","+    env.add(m);\r","+  };\r","+  panel(0xfff1dc, 4.0, 12, 8, [0, 5.9, 0], [Math.PI / 2, 0, 0]);\r","+  panel(0xbcd0ff, 1.6, 10, 6, [-9.9, 2, 0], [0, Math.PI / 2, 0]);\r","+  panel(0xfff6ea, 2.2, 8, 5, [9.9, 2.5, 3], [0, -Math.PI / 2, 0]);\r","+  const floor = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), new THREE.MeshBasicMaterial({ color: 0x1a1816 }));\r","+  floor.rotation.x = -Math.PI / 2;\r","+  floor.position.y = -5.9;\r","+  env.add(floor);\r","+  const pmrem = new THREE.PMREMGenerator(renderer);\r","+  const tex = pmrem.fromScene(env, 0.04).texture;\r","+  pmrem.dispose();\r","+  return tex;\r","+}\r","+\r","+export class Viewer3D {\r","+  constructor(host) {\r","+    this.host = host;\r","+    const r = (this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false }));\r","+    r.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\r","+    r.outputColorSpace = THREE.SRGBColorSpace;\r","+    r.toneMapping = THREE.ACESFilmicToneMapping;\r","+    r.shadowMap.enabled = true;\r","+    r.shadowMap.type = THREE.PCFSoftShadowMap;\r","+    r.setClearColor(0x0b0a09, 1);\r","+    r.domElement.className = \"v3-canvas\";\r","+    host.append(r.domElement);\r","+\r","+    const scene = (this.scene = new THREE.Scene());\r","+    // A soft studio environment for reflections: glass, metal and polished\r","+    // stone need something to reflect, or they read as flat colour.\r","+    scene.environment = studioEnvironment(r);\r","+    r.toneMappingExposure = 1.0;\r","+    this.hemi = new THREE.HemisphereLight(0xf4ead8, 0x221c16, 0.7);\r","+    scene.add(this.hemi);\r","+    const sun = (this.sun = new THREE.DirectionalLight(0xfff1dc, 2.1));\r","+    sun.castShadow = true;\r","+    sun.shadow.mapSize.set(2048, 2048);\r","+    sun.shadow.bias = -0.0005;\r","+    scene.add(sun, sun.target);\r","+    const fill = new THREE.DirectionalLight(0xbcd0ff, 0.45);\r","+    fill.position.set(-1, 0.6, -0.8);\r","+    scene.add(fill);\r","+\r","+    this.camera = new THREE.PerspectiveCamera(32, 1, 0.1, 500);\r","+    const c = (this.controls = new OrbitControls(this.camera, r.domElement));\r","+    c.enableDamping = true;\r","+    c.dampingFactor = 0.08;\r","+    c.maxPolarAngle = Math.PI * 0.49;\r","+    c.autoRotate = !window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\r","+    c.autoRotateSpeed = 0.5;\r","+    c.addEventListener(\"start\", () => { c.autoRotate = false; });\r","+\r","+    this.ro = new ResizeObserver(() => this.resize());\r","+    this.ro.observe(host);\r","+    this.resize();\r","+    this._tick = this._tick.bind(this);\r","+    this.raf = requestAnimationFrame(this._tick);\r","+  }\r","+\r","+  resize() {\r","+    const w = this.host.clientWidth, h = this.host.clientHeight;\r","+    if (!w || !h) return;\r","+    this.renderer.setSize(w, h, false);\r","+    this.camera.aspect = w / h;\r","+    this.camera.updateProjectionMatrix();\r","+  }\r","+\r","+  async load(url) {\r","+    const gltf = await new GLTFLoader().loadAsync(url);\r","+    this.lamps = [];\r","+    if (this.model) this.scene.remove(this.model);\r","+    const m = (this.model = gltf.scene);\r","+    let tris = 0;\r","+    m.traverse((o) => {\r","+      if (!o.isMesh) return;\r","+      o.castShadow = true;\r","+      o.receiveShadow = true;\r","+      const g = o.geometry;\r","+      tris += (g.index ? g.index.count : g.attributes.position.count) / 3;\r","+      for (const mat of [].concat(o.material)) {\r","+        if (mat && mat.transparent) { o.castShadow = false; mat.depthWrite = false; }\r","+        if (mat && mat.emissive && mat.emissive.getHex() !== 0) { o.castShadow = false; mat.emissiveIntensity = 0; this.lamps.push(mat); }\r","+      }\r","+    });\r","+    this.scene.add(m);\r","+\r","+    // Frame it: centre on the footprint, sit it on the table, and light it\r","+    // from over the viewer's shoulder so the faces you see first read.\r","+    const box = new THREE.Box3().setFromObject(m);\r","+    const size = box.getSize(new THREE.Vector3());\r","+    const centre = box.getCenter(new THREE.Vector3());\r","+    m.position.sub(new THREE.Vector3(centre.x, box.min.y, centre.z));\r","+    const span = Math.max(size.x, size.z, size.y * 1.5);\r","+\r","+    const ground = new THREE.Mesh(new THREE.CircleGeometry(span * 1.6, 64),\r","+      new THREE.MeshStandardMaterial({ color: 0x141312, roughness: 1 }));\r","+    ground.rotation.x = -Math.PI / 2;\r","+    ground.position.y = -0.002;\r","+    ground.receiveShadow = true;\r","+    if (this.ground) this.scene.remove(this.ground);\r","+    this.ground = ground;\r","+    this.scene.add(ground);\r","+\r","+    const sc = this.sun.shadow.camera;\r","+    sc.left = -span; sc.right = span; sc.top = span; sc.bottom = -span; sc.far = span * 6;\r","+    sc.updateProjectionMatrix();\r","+    this.sun.position.set(span * 0.35, span * 1.7, span * 1.25);\r","+\r","+    const dist = span / (2 * Math.tan((this.camera.fov * Math.PI) / 360)) * 1.35;\r","+    this.camera.position.set(dist * 0.62, dist * 0.55, dist * 0.78);\r","+    this.controls.target.set(0, size.y * 0.3, 0);\r","+    this.controls.minDistance = span * 0.4;\r","+    this.controls.maxDistance = span * 4;\r","+    this.controls.update();\r","+    return { triangles: Math.round(tris), width: size.x, depth: size.z, height: size.y };\r","+  }\r","+\r","+  // Exterior: the whole house. Interior: the roof and every floor above the\r","+  // one in view lifted away, ceiling lights hidden so the rooms read from\r","+  // above. Night: dusk light, the lamps on and glowing through the glass.\r","+  setMode(mode, level = 0) {\r","+    if (!this.model) return;\r","+    const levels = [];\r","+    this.model.traverse((o) => { const m = /^level_(\\d+)$/.exec(o.name); if (m) levels.push([+m[1], o]); });\r","+    const top = levels.length ? Math.max(...levels.map(([i]) => i)) : 0;\r","+    const show = mode === \"interior\" ? Math.min(level, top) : top;\r","+    for (const [i, o] of levels) o.visible = i <= show;\r","+    const roof = this.model.getObjectByName(\"roof\");\r","+    if (roof) roof.visible = mode !== \"interior\";\r","+    this.model.traverse((o) => { if (o.isMesh && /\\/lights\\//.test(o.name)) o.visible = mode !== \"interior\"; });\r","+    const night = mode === \"night\";\r","+    this.hemi.intensity = night ? 0.12 : 0.7;\r","+    this.sun.intensity = night ? 0.15 : 2.1;\r","+    this.renderer.toneMappingExposure = night ? 0.85 : 1.0;\r","+    this.scene.environmentIntensity = night ? 0.15 : 1.0;\r","+    for (const m of this.lamps) m.emissiveIntensity = night ? 2.4 : 0;\r","+    this.renderer.setClearColor(night ? 0x07080c : 0x0b0a09, 1);\r","+    this.mode = mode;\r","+    return { levels: top + 1 };\r","+  }\r","+\r","+  _tick() {\r","+    this.raf = requestAnimationFrame(this._tick);\r","+    this.controls.update();\r","+    this.renderer.render(this.scene, this.camera);\r","+  }\r","+\r","+  dispose() {\r","+    cancelAnimationFrame(this.raf);\r","+    this.ro.disconnect();\r","+    this.controls.dispose();\r","+    this.renderer.dispose();\r","+    this.renderer.domElement.remove();\r","+  }\r","+}"]}]}],"moreFiles":0,"changedFiles":["F:\\Users\\shrey\\Desktop\\AI Project\\frontend\\viewer3d.js"],"shared":true}},"sourceToolAssistantUUID":"47927681-cf1c-45a7-ae11-20b1e8c548d4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
