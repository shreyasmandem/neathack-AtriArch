{"parentUuid":"d0330a33-2ec2-4dd5-9b3e-3e728ad5fbab","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cft95PRVHNB4reWuGvp2H","type":"message","role":"assistant","content":[{"type":"text","text":"Writing a plan-quality sweep: about 30 varied briefs scored for defects a client would spot, to find out exactly what \"really bad sometimes\" means."}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1908,"cache_read_input_tokens":682239,"output_tokens":3416,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1908,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":3416,"cache_read_input_tokens":682239,"cache_creation_input_tokens":1908,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1908},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011Cft95P2RfUT2fCf1UGJbk","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"332d72f5-45ae-4a24-b610-8644f26a7a8d","timestamp":"2026-10-10T07:11:38.717Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
{"parentUuid":"332d72f5-45ae-4a24-b610-8644f26a7a8d","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cft95PRVHNB4reWuGvp2H","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PP4r47AdwCTxQ7zezfp6h7","name":"Write","input":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py","content":"\"\"\"Generate plans across a spread of realistic briefs and score each for the\ndefects a client spots in the first ten seconds.\n\nRun:  python -m scripts.plan_sweep [--n 30] [--svg]   (from backend/)\n\nWrites var/sweep/report.json and, with --svg, one floor-plan SVG per level so\nthe worst plans can be looked at, not just counted.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport random\nimport time\nfrom collections import Counter\nfrom pathlib import Path\n\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\n\nfrom aip.api.schemas import SimpleBriefRequest\nfrom aip.domain.geometry import Direction\nfrom aip.domain.plan import FloorPlan, RoomType\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"sweep\"\n\nPUBLIC = {RoomType.LIVING, RoomType.DINING, RoomType.KITCHEN}\nWET = {RoomType.BATHROOM, RoomType.TOILET} if hasattr(RoomType, \"TOILET\") else {RoomType.BATHROOM}\n\n\ndef briefs(n: int, seed: int = 11) -> list[SimpleBriefRequest]:\n    rng = random.Random(seed)\n    out = []\n    shapes = [(9, 12), (9, 15), (10, 14), (12, 18), (12, 20), (15, 20), (15, 25), (18, 24), (20, 30), (24, 18), (30, 15)]\n    for i in range(n):\n        w, d = rng.choice(shapes)\n        levels = rng.choice([1, 1, 2, 2, 2, 3])\n        beds = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5])\n        out.append(SimpleBriefRequest(\n            project_name=f\"sweep {i}\",\n            plot_width=w, plot_depth=d, levels=levels, bedrooms=beds,\n            bathrooms=max(1, min(beds + rng.choice([-1, 0, 0, 1]), 6)),\n            road_direction=rng.choice(list(Direction)),\n            vastu=rng.choice([\"ignore\", \"advisory\", \"balanced\", \"strict\"]),\n            amenities=rng.sample([\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"], rng.randint(1, 4)),\n            occupant_elders=rng.choice([0, 0, 1, 2]),\n            setback_front=rng.choice([1.5, 2.0, 3.0]), setback_rear=1.5,\n            setback_left=rng.choice([1.0, 1.2]), setback_right=rng.choice([1.0, 1.2]),\n        ))\n    return out\n\n\ndef defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:\n    d: dict[str, list[str]] = {}\n\n    def add(kind: str, msg: str) -> None:\n        d.setdefault(kind, []).append(msg)\n\n    for msg in gen._sanity(plan):  # noqa: SLF001 - the generator's own guardrail\n        add(\"guardrail\", msg)\n\n    for level in plan.levels:\n        rooms = level.rooms\n        by_id = {r.id: r for r in rooms}\n        doors = [o for w in level.walls for o in w.openings if o.kind.is_door]\n        windows = {r.id: 0 for r in rooms}\n        door_count = Counter()\n        for w in level.walls:\n            for o in w.openings:\n                if o.kind.is_door and o.connects:\n                    for rid in o.connects:\n                        door_count[rid] += 1\n                elif not o.kind.is_door:\n                    for rid in w.rooms:\n                        if rid in windows:\n                            windows[rid] += 1\n        tag = f\"L{level.index}\"\n        for r in rooms:\n            name = r.display_name()\n            if r.type.is_habitable and windows.get(r.id, 0) == 0:\n                add(\"no_window\", f\"{tag} {name}\")\n            if not r.type.is_outdoor and door_count[r.id] == 0 and len(rooms) > 1:\n                add(\"no_door\", f\"{tag} {name}\")\n            if door_count[r.id] > 3 and not r.type.is_circulation:\n                add(\"cut_up\", f\"{tag} {name} has {door_count[r.id]} doors\")\n            if r.type in (RoomType.LIVING, RoomType.MASTER_BEDROOM, RoomType.BEDROOM, RoomType.DINING) and r.bbox.aspect_ratio > 2.2:\n                add(\"long_room\", f\"{tag} {name} {r.bbox.aspect_ratio:.1f}:1\")\n        # A bathroom whose only door opens into the kitchen, living or dining room.\n        for o in doors:\n            if not o.connects:\n                continue\n            a, b = (by_id.get(x) for x in o.connects)\n            if a and b:\n                pair = {a.type, b.type}\n                if pair & WET and pair & PUBLIC:\n                    add(\"wc_off_public\", f\"{tag} {a.display_name()}-{b.display_name()}\")\n        # Holes and slivers inside the building: space nobody can use.\n        polys = [Polygon([(p.x, p.y) for p in r.polygon]).buffer(0) for r in rooms if len(r.polygon) >= 3]\n        if polys:\n            union = unary_union(polys)\n            hull = union.envelope\n            hole_area = hull.area - union.area\n            if hole_area > 0.08 * hull.area:\n                add(\"dead_space\", f\"{tag} {hole_area:.1f} m2 ({hole_area / hull.area:.0%}) of the footprint unused\")\n        circ = sum(r.area for r in rooms if r.type.is_circulation)\n        total = sum(r.area for r in rooms) or 1\n        if circ / total > 0.18:\n            add(\"too_much_corridor\", f\"{tag} {circ / total:.0%}\")\n    # Stairs stacked on top of each other.\n    stairs = [[r for r in lv.rooms if r.type == RoomType.STAIRCASE] for lv in plan.levels]\n    if len(plan.levels) > 1 and all(len(s) == 1 for s in stairs):\n        c0 = stairs[0][0].centre\n        for s in stairs[1:]:\n            if s[0].centre.distance_to(c0) > 0.6:\n                add(\"stairs_misaligned\", f\"offset {s[0].centre.distance_to(c0):.1f} m\")\n    return d\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--n\", type=int, default=30)\n    ap.add_argument(\"--svg\", action=\"store_true\")\n    args = ap.parse_args()\n    OUT.mkdir(parents=True, exist_ok=True)\n    rows = []\n    tally: Counter[str] = Counter()\n    for i, req in enumerate(briefs(args.n)):\n        brief = req.to_brief()\n        gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))\n        t0 = time.perf_counter()\n        try:\n            plan = gen.generate(1)[0]\n        except Exception as exc:  # noqa: BLE001\n            rows.append({\"i\": i, \"error\": f\"{type(exc).__name__}: {exc}\"})\n            tally[\"crash\"] += 1\n            print(f\"{i:2d} CRASH {exc}\")\n            continue\n        secs = time.perf_counter() - t0\n        d = defects(plan, gen)\n        for k in d:\n            tally[k] += 1\n        rows.append({\"i\": i, \"plot\": [req.plot_width, req.plot_depth], \"levels\": req.levels,\n                     \"beds\": req.bedrooms, \"road\": req.road_direction.value, \"secs\": round(secs, 1),\n                     \"defects\": d})\n        flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"\n        print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}\")\n        if args.svg:\n            from aip.engines.architecture.drawings import floor_plan_svg\n            for lv in plan.levels:\n                (OUT / f\"p{i:02d}_L{lv.index}.svg\").write_text(floor_plan_svg(plan, lv.index), encoding=\"utf-8\")\n    clean = sum(1 for r in rows if not r.get(\"defects\") and \"error\" not in r)\n    print(f\"\\nclean {clean}/{len(rows)}   defect frequency: {dict(tally.most_common())}\")\n    (OUT / \"report.json\").write_text(json.dumps({\"tally\": tally, \"rows\": rows}, indent=1, default=str), encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1908,"cache_read_input_tokens":682239,"output_tokens":3416,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1908,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":3416,"cache_read_input_tokens":682239,"cache_creation_input_tokens":1908,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1908},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01PP4r47AdwCTxQ7zezfp6h7":{"file_path":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py","content":"\"\"\"Generate plans across a spread of realistic briefs and score each for the\ndefects a client spots in the first ten seconds.\n\nRun:  python -m scripts.plan_sweep [--n 30] [--svg]   (from backend/)\n\nWrites var/sweep/report.json and, with --svg, one floor-plan SVG per level so\nthe worst plans can be looked at, not just counted.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport random\nimport time\nfrom collections import Counter\nfrom pathlib import Path\n\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\n\nfrom aip.api.schemas import SimpleBriefRequest\nfrom aip.domain.geometry import Direction\nfrom aip.domain.plan import FloorPlan, RoomType\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"sweep\"\n\nPUBLIC = {RoomType.LIVING, RoomType.DINING, RoomType.KITCHEN}\nWET = {RoomType.BATHROOM, RoomType.TOILET} if hasattr(RoomType, \"TOILET\") else {RoomType.BATHROOM}\n\n\ndef briefs(n: int, seed: int = 11) -> list[SimpleBriefRequest]:\n    rng = random.Random(seed)\n    out = []\n    shapes = [(9, 12), (9, 15), (10, 14), (12, 18), (12, 20), (15, 20), (15, 25), (18, 24), (20, 30), (24, 18), (30, 15)]\n    for i in range(n):\n        w, d = rng.choice(shapes)\n        levels = rng.choice([1, 1, 2, 2, 2, 3])\n        beds = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5])\n        out.append(SimpleBriefRequest(\n            project_name=f\"sweep {i}\",\n            plot_width=w, plot_depth=d, levels=levels, bedrooms=beds,\n            bathrooms=max(1, min(beds + rng.choice([-1, 0, 0, 1]), 6)),\n            road_direction=rng.choice(list(Direction)),\n            vastu=rng.choice([\"ignore\", \"advisory\", \"balanced\", \"strict\"]),\n            amenities=rng.sample([\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"], rng.randint(1, 4)),\n            occupant_elders=rng.choice([0, 0, 1, 2]),\n            setback_front=rng.choice([1.5, 2.0, 3.0]), setback_rear=1.5,\n            setback_left=rng.choice([1.0, 1.2]), setback_right=rng.choice([1.0, 1.2]),\n        ))\n    return out\n\n\ndef defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:\n    d: dict[str, list[str]] = {}\n\n    def add(kind: str, msg: str) -> None:\n        d.setdefault(kind, []).append(msg)\n\n    for msg in gen._sanity(plan):  # noqa: SLF001 - the generator's own guardrail\n        add(\"guardrail\", msg)\n\n    for level in plan.levels:\n        rooms = level.rooms\n        by_id = {r.id: r for r in rooms}\n        doors = [o for w in level.walls for o in w.openings if o.kind.is_door]\n        windows = {r.id: 0 for r in rooms}\n        door_count = Counter()\n        for w in level.walls:\n            for o in w.openings:\n                if o.kind.is_door and o.connects:\n                    for rid in o.connects:\n                        door_count[rid] += 1\n                elif not o.kind.is_door:\n                    for rid in w.rooms:\n                        if rid in windows:\n                            windows[rid] += 1\n        tag = f\"L{level.index}\"\n        for r in rooms:\n            name = r.display_name()\n            if r.type.is_habitable and windows.get(r.id, 0) == 0:\n                add(\"no_window\", f\"{tag} {name}\")\n            if not r.type.is_outdoor and door_count[r.id] == 0 and len(rooms) > 1:\n                add(\"no_door\", f\"{tag} {name}\")\n            if door_count[r.id] > 3 and not r.type.is_circulation:\n                add(\"cut_up\", f\"{tag} {name} has {door_count[r.id]} doors\")\n            if r.type in (RoomType.LIVING, RoomType.MASTER_BEDROOM, RoomType.BEDROOM, RoomType.DINING) and r.bbox.aspect_ratio > 2.2:\n                add(\"long_room\", f\"{tag} {name} {r.bbox.aspect_ratio:.1f}:1\")\n        # A bathroom whose only door opens into the kitchen, living or dining room.\n        for o in doors:\n            if not o.connects:\n                continue\n            a, b = (by_id.get(x) for x in o.connects)\n            if a and b:\n                pair = {a.type, b.type}\n                if pair & WET and pair & PUBLIC:\n                    add(\"wc_off_public\", f\"{tag} {a.display_name()}-{b.display_name()}\")\n        # Holes and slivers inside the building: space nobody can use.\n        polys = [Polygon([(p.x, p.y) for p in r.polygon]).buffer(0) for r in rooms if len(r.polygon) >= 3]\n        if polys:\n            union = unary_union(polys)\n            hull = union.envelope\n            hole_area = hull.area - union.area\n            if hole_area > 0.08 * hull.area:\n                add(\"dead_space\", f\"{tag} {hole_area:.1f} m2 ({hole_area / hull.area:.0%}) of the footprint unused\")\n        circ = sum(r.area for r in rooms if r.type.is_circulation)\n        total = sum(r.area for r in rooms) or 1\n        if circ / total > 0.18:\n            add(\"too_much_corridor\", f\"{tag} {circ / total:.0%}\")\n    # Stairs stacked on top of each other.\n    stairs = [[r for r in lv.rooms if r.type == RoomType.STAIRCASE] for lv in plan.levels]\n    if len(plan.levels) > 1 and all(len(s) == 1 for s in stairs):\n        c0 = stairs[0][0].centre\n        for s in stairs[1:]:\n            if s[0].centre.distance_to(c0) > 0.6:\n                add(\"stairs_misaligned\", f\"offset {s[0].centre.distance_to(c0):.1f} m\")\n    return d\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--n\", type=int, default=30)\n    ap.add_argument(\"--svg\", action=\"store_true\")\n    args = ap.parse_args()\n    OUT.mkdir(parents=True, exist_ok=True)\n    rows = []\n    tally: Counter[str] = Counter()\n    for i, req in enumerate(briefs(args.n)):\n        brief = req.to_brief()\n        gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))\n        t0 = time.perf_counter()\n        try:\n            plan = gen.generate(1)[0]\n        except Exception as exc:  # noqa: BLE001\n            rows.append({\"i\": i, \"error\": f\"{type(exc).__name__}: {exc}\"})\n            tally[\"crash\"] += 1\n            print(f\"{i:2d} CRASH {exc}\")\n            continue\n        secs = time.perf_counter() - t0\n        d = defects(plan, gen)\n        for k in d:\n            tally[k] += 1\n        rows.append({\"i\": i, \"plot\": [req.plot_width, req.plot_depth], \"levels\": req.levels,\n                     \"beds\": req.bedrooms, \"road\": req.road_direction.value, \"secs\": round(secs, 1),\n                     \"defects\": d})\n        flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"\n        print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}\")\n        if args.svg:\n            from aip.engines.architecture.drawings import floor_plan_svg\n            for lv in plan.levels:\n                (OUT / f\"p{i:02d}_L{lv.index}.svg\").write_text(floor_plan_svg(plan, lv.index), encoding=\"utf-8\")\n    clean = sum(1 for r in rows if not r.get(\"defects\") and \"error\" not in r)\n    print(f\"\\nclean {clean}/{len(rows)}   defect frequency: {dict(tally.most_common())}\")\n    (OUT / \"report.json\").write_text(json.dumps({\"tally\": tally, \"rows\": rows}, indent=1, default=str), encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"apiBlockIndex":1,"requestId":"req_011Cft95P2RfUT2fCf1UGJbk","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"fe64bfbb-a7fc-4e0d-8f73-ae76b49239aa","timestamp":"2026-10-10T07:12:02.062Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
{"parentUuid":"fe64bfbb-a7fc-4e0d-8f73-ae76b49239aa","isSidechain":false,"promptId":"cde90b88-60f3-4a8e-aba6-b51e470ae5ea","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PP4r47AdwCTxQ7zezfp6h7","type":"tool_result","content":"File created successfully at: F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py (file state is current in your context — no need to Read it back)"}]},"uuid":"907b9419-a097-417f-ae91-0fddbaba869e","timestamp":"2026-10-10T07:12:02.440Z","toolUseResult":{"type":"create","filePath":"F:\\Users\\shrey\\Desktop\\AI Project\\backend\\scripts\\plan_sweep.py","content":"\"\"\"Generate plans across a spread of realistic briefs and score each for the\ndefects a client spots in the first ten seconds.\n\nRun:  python -m scripts.plan_sweep [--n 30] [--svg]   (from backend/)\n\nWrites var/sweep/report.json and, with --svg, one floor-plan SVG per level so\nthe worst plans can be looked at, not just counted.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport random\nimport time\nfrom collections import Counter\nfrom pathlib import Path\n\nfrom shapely.geometry import Polygon\nfrom shapely.ops import unary_union\n\nfrom aip.api.schemas import SimpleBriefRequest\nfrom aip.domain.geometry import Direction\nfrom aip.domain.plan import FloorPlan, RoomType\nfrom aip.engines.architecture.layout import GeneratorConfig, LayoutGenerator\n\nOUT = Path(__file__).resolve().parent.parent / \"var\" / \"sweep\"\n\nPUBLIC = {RoomType.LIVING, RoomType.DINING, RoomType.KITCHEN}\nWET = {RoomType.BATHROOM, RoomType.TOILET} if hasattr(RoomType, \"TOILET\") else {RoomType.BATHROOM}\n\n\ndef briefs(n: int, seed: int = 11) -> list[SimpleBriefRequest]:\n    rng = random.Random(seed)\n    out = []\n    shapes = [(9, 12), (9, 15), (10, 14), (12, 18), (12, 20), (15, 20), (15, 25), (18, 24), (20, 30), (24, 18), (30, 15)]\n    for i in range(n):\n        w, d = rng.choice(shapes)\n        levels = rng.choice([1, 1, 2, 2, 2, 3])\n        beds = rng.choice([1, 2, 2, 3, 3, 3, 4, 4, 5])\n        out.append(SimpleBriefRequest(\n            project_name=f\"sweep {i}\",\n            plot_width=w, plot_depth=d, levels=levels, bedrooms=beds,\n            bathrooms=max(1, min(beds + rng.choice([-1, 0, 0, 1]), 6)),\n            road_direction=rng.choice(list(Direction)),\n            vastu=rng.choice([\"ignore\", \"advisory\", \"balanced\", \"strict\"]),\n            amenities=rng.sample([\"pooja\", \"dining\", \"study\", \"utility\", \"balcony\", \"parking\"], rng.randint(1, 4)),\n            occupant_elders=rng.choice([0, 0, 1, 2]),\n            setback_front=rng.choice([1.5, 2.0, 3.0]), setback_rear=1.5,\n            setback_left=rng.choice([1.0, 1.2]), setback_right=rng.choice([1.0, 1.2]),\n        ))\n    return out\n\n\ndef defects(plan: FloorPlan, gen: LayoutGenerator) -> dict[str, list[str]]:\n    d: dict[str, list[str]] = {}\n\n    def add(kind: str, msg: str) -> None:\n        d.setdefault(kind, []).append(msg)\n\n    for msg in gen._sanity(plan):  # noqa: SLF001 - the generator's own guardrail\n        add(\"guardrail\", msg)\n\n    for level in plan.levels:\n        rooms = level.rooms\n        by_id = {r.id: r for r in rooms}\n        doors = [o for w in level.walls for o in w.openings if o.kind.is_door]\n        windows = {r.id: 0 for r in rooms}\n        door_count = Counter()\n        for w in level.walls:\n            for o in w.openings:\n                if o.kind.is_door and o.connects:\n                    for rid in o.connects:\n                        door_count[rid] += 1\n                elif not o.kind.is_door:\n                    for rid in w.rooms:\n                        if rid in windows:\n                            windows[rid] += 1\n        tag = f\"L{level.index}\"\n        for r in rooms:\n            name = r.display_name()\n            if r.type.is_habitable and windows.get(r.id, 0) == 0:\n                add(\"no_window\", f\"{tag} {name}\")\n            if not r.type.is_outdoor and door_count[r.id] == 0 and len(rooms) > 1:\n                add(\"no_door\", f\"{tag} {name}\")\n            if door_count[r.id] > 3 and not r.type.is_circulation:\n                add(\"cut_up\", f\"{tag} {name} has {door_count[r.id]} doors\")\n            if r.type in (RoomType.LIVING, RoomType.MASTER_BEDROOM, RoomType.BEDROOM, RoomType.DINING) and r.bbox.aspect_ratio > 2.2:\n                add(\"long_room\", f\"{tag} {name} {r.bbox.aspect_ratio:.1f}:1\")\n        # A bathroom whose only door opens into the kitchen, living or dining room.\n        for o in doors:\n            if not o.connects:\n                continue\n            a, b = (by_id.get(x) for x in o.connects)\n            if a and b:\n                pair = {a.type, b.type}\n                if pair & WET and pair & PUBLIC:\n                    add(\"wc_off_public\", f\"{tag} {a.display_name()}-{b.display_name()}\")\n        # Holes and slivers inside the building: space nobody can use.\n        polys = [Polygon([(p.x, p.y) for p in r.polygon]).buffer(0) for r in rooms if len(r.polygon) >= 3]\n        if polys:\n            union = unary_union(polys)\n            hull = union.envelope\n            hole_area = hull.area - union.area\n            if hole_area > 0.08 * hull.area:\n                add(\"dead_space\", f\"{tag} {hole_area:.1f} m2 ({hole_area / hull.area:.0%}) of the footprint unused\")\n        circ = sum(r.area for r in rooms if r.type.is_circulation)\n        total = sum(r.area for r in rooms) or 1\n        if circ / total > 0.18:\n            add(\"too_much_corridor\", f\"{tag} {circ / total:.0%}\")\n    # Stairs stacked on top of each other.\n    stairs = [[r for r in lv.rooms if r.type == RoomType.STAIRCASE] for lv in plan.levels]\n    if len(plan.levels) > 1 and all(len(s) == 1 for s in stairs):\n        c0 = stairs[0][0].centre\n        for s in stairs[1:]:\n            if s[0].centre.distance_to(c0) > 0.6:\n                add(\"stairs_misaligned\", f\"offset {s[0].centre.distance_to(c0):.1f} m\")\n    return d\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--n\", type=int, default=30)\n    ap.add_argument(\"--svg\", action=\"store_true\")\n    args = ap.parse_args()\n    OUT.mkdir(parents=True, exist_ok=True)\n    rows = []\n    tally: Counter[str] = Counter()\n    for i, req in enumerate(briefs(args.n)):\n        brief = req.to_brief()\n        gen = LayoutGenerator(brief, GeneratorConfig(seed=100 + i))\n        t0 = time.perf_counter()\n        try:\n            plan = gen.generate(1)[0]\n        except Exception as exc:  # noqa: BLE001\n            rows.append({\"i\": i, \"error\": f\"{type(exc).__name__}: {exc}\"})\n            tally[\"crash\"] += 1\n            print(f\"{i:2d} CRASH {exc}\")\n            continue\n        secs = time.perf_counter() - t0\n        d = defects(plan, gen)\n        for k in d:\n            tally[k] += 1\n        rows.append({\"i\": i, \"plot\": [req.plot_width, req.plot_depth], \"levels\": req.levels,\n                     \"beds\": req.bedrooms, \"road\": req.road_direction.value, \"secs\": round(secs, 1),\n                     \"defects\": d})\n        flag = \" \".join(f\"{k}:{len(v)}\" for k, v in d.items()) or \"clean\"\n        print(f\"{i:2d} {req.plot_width:>4.0f}x{req.plot_depth:<4.0f} L{req.levels} {req.bedrooms}bhk road {req.road_direction.value:<2} {secs:5.1f}s  {flag}\")\n        if args.svg:\n            from aip.engines.architecture.drawings import floor_plan_svg\n            for lv in plan.levels:\n                (OUT / f\"p{i:02d}_L{lv.index}.svg\").write_text(floor_plan_svg(plan, lv.index), encoding=\"utf-8\")\n    clean = sum(1 for r in rows if not r.get(\"defects\") and \"error\" not in r)\n    print(f\"\\nclean {clean}/{len(rows)}   defect frequency: {dict(tally.most_common())}\")\n    (OUT / \"report.json\").write_text(json.dumps({\"tally\": tally, \"rows\": rows}, indent=1, default=str), encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"fe64bfbb-a7fc-4e0d-8f73-ae76b49239aa","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
