{"parentUuid":"52693516-0eae-4ba7-b4e2-b4267abf5841","isSidechain":false,"attachment":{"type":"hook_success","hookName":"SessionStart:compact","toolUseID":"c5415d01-9bd0-4dff-b054-ed4a2767f2d2","hookEvent":"SessionStart","content":"","stdout":"{\"systemMessage\":\"\\n\\nEntire CLI will link this conversation to your next commit.\"}\n","stderr":"","exitCode":0,"command":"sh -c 'if ! command -v entire >/dev/null 2>&1; then printf \"%s\\n\" \"{\\\"systemMessage\\\":\\\"\\\\n\\\\nEntire CLI is enabled but not installed or not on PATH.\\\\nInstallation guide: https://docs.entire.io/cli/installation#installation-methods\\\"}\"; exit 0; fi; exec entire hooks claude-code session-start'","durationMs":1032},"type":"attachment","uuid":"00b4c41b-79df-455e-85c1-a793da88f87d","timestamp":"2026-10-11T05:55:38.079Z","userType":"external","entrypoint":"claude-desktop","cwd":"F:\\Users\\shrey\\Desktop\\AI Project\\backend","sessionId":"fd077be5-cd09-4d91-beb4-30df27c1398e","version":"2.1.295","gitBranch":"main","slug":"fluttering-mapping-sloth"}
