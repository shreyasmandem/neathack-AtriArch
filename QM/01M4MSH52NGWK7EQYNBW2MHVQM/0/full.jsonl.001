lugin:small-business:zoho-crm","plugin:small-business:zoho-desk","plugin:small-business:zoho-projects","plugin:small-business:zoom"],"failedMcpServers":[{"name":"plugin:legal:docusign","errorCode":"ENOTFOUND","error":"getaddrinfo ENOTFOUND mcp.docusign.com"},{"name":"plugin:pdf-viewer:pdf","errorCode":"CONNECT_TIMEOUT","error":"MCP server plugin:pdf-viewer:pdf connection timed out after 30000ms"},{"name":"plugin:small-business:intuit-mailchimp","errorCode":"ENOTFOUND","error":"getaddrinfo ENOTFOUND ai-inc.mailchimp.com"},{"name":"plugin:small-business:intuit-quickbooks","errorCode":"ENOTFOUND","error":"getaddrinfo ENOTFOUND ai-inc.quickbooks.intuit.com"},{"name":"plugin:small-business:shopify","errorCode":"ENOTFOUND","error":"getaddrinfo ENOTFOUND setup.shopify.com"},{"name":"plugin:small-business:tiktok","errorCode":"ENOTFOUND","error":"getaddrinfo ENOTFOUND business-api.tiktok.com"}]},"type":"attachment","uuid":"e9c52fa7-74b0-465f-ad34-87072a241c15","timestamp":"2026-10-11T05:55:45.894Z","rendered":[{"content":"<system-reminder>\nThe following MCP servers require authentication before their tools can be used:\nplugin:data:definite, plugin:data:hex, plugin:engineering:datadog, plugin:engineering:github, plugin:engineering:pagerduty, plugin:enterprise-search:guru, plugin:finance:bigquery, plugin:legal:atlassian, plugin:legal:box, plugin:legal:egnyte, plugin:legal:slack, plugin:marketing:ahrefs, plugin:marketing:klaviyo, plugin:marketing:similarweb, plugin:marketing:supermetrics, plugin:product-management:amplitude, plugin:product-management:amplitude-eu, plugin:product-management:figma, plugin:product-management:fireflies, plugin:product-management:intercom, plugin:product-management:pendo, plugin:product-management:similarweb, plugin:productivity:asana, plugin:productivity:clickup, plugin:productivity:linear, plugin:productivity:monday, plugin:productivity:notion, plugin:sales:calendly, plugin:sales:close, plugin:sales:crunchbase, …and 33 more\n\nClaude cannot star